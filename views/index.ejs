<%- include('partials/header') %>

  <!--
=============================================================
  FLU — Your Ride | Ultra Premium Homepage
  Theme   : Midnight Black + Electric Lime (#C8F135)
  Fonts   : Clash Display (headings) + Satoshi (body)
  Features: Pill navbar · Text scramble · Grain overlay
            Magnetic buttons · Marquee · Scroll reveal
            Moving road · Glassmorphism cards
=============================================================
-->

  <style>
    /* ===================== FONTS ===================== */
    @import url('https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@300,400,500,700&display=swap');

    /* ===================== VARIABLES ===================== */
    :root {
      --lime: #C8F135;
      --lime-dim: #a8cc20;
      --white: #ffffff;
      --off-white: #e8e8e8;
      --grey: #888888;
      --dark-grey: #1c1c1c;
      --black: #080808;
      --card: #101010;
      --border: #1e1e1e;
      --glass: rgba(255, 255, 255, 0.04);
    }

    /* ===================== RESET ===================== */
    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--black);
      color: var(--white);
      font-family: 'Satoshi', sans-serif;
      overflow-x: hidden;
      /* cursor: default — normal browser cursor */
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button {
      font-family: 'Satoshi', sans-serif;
    }

    /* ===================== GRAIN OVERLAY ===================== */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
      opacity: 0.025;
      pointer-events: none;
      z-index: 9999;
    }

    /* ===================== FLOATING PILL NAVBAR ===================== */
    .flu-navbar {
      position: fixed;
      top: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
      width: calc(100% - 4rem);
      max-width: 1100px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(10, 10, 10, 0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 0.7rem 0.7rem 0.7rem 1.8rem;
      transition: all 0.4s ease;
    }

    .flu-navbar.nav-hidden {
      transform: translateX(-50%) translateY(-120%);
    }

    /* Logo */
    .nav-logo {
      font-family: 'Clash Display', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 3px;
      color: var(--lime);
      white-space: nowrap;
    }

    .nav-logo sub {
      font-family: 'Satoshi', sans-serif;
      font-size: 0.6rem;
      color: var(--grey);
      letter-spacing: 2px;
      font-weight: 400;
      margin-left: 4px;
      vertical-align: middle;
    }

    /* Center links */
    .nav-center {
      display: flex;
      gap: 0.2rem;
      align-items: center;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .nav-center a {
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--grey);
      letter-spacing: 0.5px;
      padding: 0.45rem 1rem;
      border-radius: 100px;
      transition: color 0.25s, background 0.25s;
    }

    .nav-center a:hover {
      color: var(--white);
      background: var(--dark-grey);
    }

    .nav-center a.active {
      color: var(--black);
      background: var(--lime);
    }

    /* Right actions */
    .nav-right {
      display: flex;
      gap: 0.6rem;
      align-items: center;
    }

    .nav-btn-ghost {
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--grey);
      background: transparent;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 100px;
      transition: color 0.25s;
    }

    .nav-btn-ghost:hover {
      color: var(--white);
    }

    .nav-btn-lime {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--black);
      background: var(--lime);
      border: none;
      padding: 0.55rem 1.3rem;
      border-radius: 100px;
      transition: opacity 0.25s, transform 0.2s;
    }

    .nav-btn-lime:hover {
      opacity: 0.85;
      transform: scale(0.98);
    }

    /* Logged-in user chip */
    .nav-user-chip {
      display: none;
      align-items: center;
      gap: 0.5rem;
      background: var(--dark-grey);
      border-radius: 100px;
      padding: 0.35rem 1rem 0.35rem 0.5rem;
    }

    .nav-user-avatar {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--lime);
      color: var(--black);
      font-size: 0.72rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-user-name {
      font-size: 0.8rem;
      color: var(--off-white);
      font-weight: 500;
    }

    /* ===================== HERO ===================== */
    .hero {
      min-height: 100vh;
      padding: 0 4rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Background radial glow */
    .hero-glow {
      position: absolute;
      top: -10%;
      left: 30%;
      width: 800px;
      height: 800px;
      background: radial-gradient(circle, rgba(200, 241, 53, 0.05) 0%, transparent 65%);
      pointer-events: none;
    }

    .hero-glow-2 {
      position: absolute;
      bottom: -20%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(200, 241, 53, 0.03) 0%, transparent 70%);
      pointer-events: none;
    }

    /* Speed lines in background */
    .hero-lines {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .hero-lines span {
      position: absolute;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(200, 241, 53, 0.08), transparent);
      animation: speedLine 3s linear infinite;
      opacity: 0;
    }

    .hero-lines span:nth-child(1) {
      top: 25%;
      width: 40%;
      animation-delay: 0s;
    }

    .hero-lines span:nth-child(2) {
      top: 45%;
      width: 60%;
      animation-delay: 0.8s;
    }

    .hero-lines span:nth-child(3) {
      top: 65%;
      width: 30%;
      animation-delay: 1.6s;
    }

    .hero-lines span:nth-child(4) {
      top: 75%;
      width: 50%;
      animation-delay: 2.2s;
    }

    @keyframes speedLine {
      0% {
        left: -60%;
        opacity: 0;
      }

      10% {
        opacity: 1;
      }

      90% {
        opacity: 0.6;
      }

      100% {
        left: 110%;
        opacity: 0;
      }
    }

    /* Pill badge */
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--glass);
      border: 1px solid var(--border);
      padding: 0.35rem 1rem 0.35rem 0.5rem;
      border-radius: 100px;
      width: fit-content;
      margin-bottom: 2.5rem;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .hero-badge.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .badge-dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: rgba(200, 241, 53, 0.12);
      border: 1px solid rgba(200, 241, 53, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .badge-dot::after {
      content: '';
      width: 7px;
      height: 7px;
      background: var(--lime);
      border-radius: 50%;
      animation: pulse 1.8s ease infinite;
    }

    @keyframes pulse {

      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }

      50% {
        transform: scale(1.4);
        opacity: 0.5;
      }
    }

    .badge-text {
      font-size: 0.78rem;
      color: var(--grey);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 500;
    }

    /* Main heading */
    .hero-h1 {
      font-family: 'Clash Display', sans-serif;
      font-size: clamp(4.5rem, 11vw, 10.5rem);
      font-weight: 700;
      line-height: 0.88;
      letter-spacing: -1px;
      overflow: hidden;
    }

    .hero-h1 .word {
      display: inline-block;
      overflow: hidden;
      margin-right: 0.15em;
    }

    .hero-h1 .word span {
      display: inline-block;
      transform: translateY(110%);
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-h1 .accent {
      color: var(--lime);
    }

    /* Subheading */
    .hero-desc {
      max-width: 500px;
      color: var(--grey);
      font-size: 1rem;
      line-height: 1.8;
      margin-top: 2.5rem;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.6s ease 0.9s, transform 0.6s ease 0.9s;
    }

    .hero-desc.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Hero CTA */
    .hero-cta {
      display: flex;
      gap: 1rem;
      align-items: center;
      margin-top: 2.5rem;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.6s ease 1.1s, transform 0.6s ease 1.1s;
    }

    .hero-cta.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Magnetic CTA button */
    .btn-magnetic {
      position: relative;
      overflow: hidden;
      background: var(--lime);
      color: var(--black);
      padding: 1rem 2.8rem;
      border-radius: 100px;
      font-size: 0.92rem;
      font-weight: 700;
      border: none;
      letter-spacing: 0.5px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      box-shadow: 0 0 0 rgba(200, 241, 53, 0);
    }

    .btn-magnetic:hover {
      box-shadow: 0 8px 40px rgba(200, 241, 53, 0.25);
    }

    .btn-magnetic .btn-text {
      position: relative;
      z-index: 1;
    }

    .btn-magnetic::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--lime-dim);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .btn-magnetic:hover::after {
      opacity: 1;
    }

    .btn-ghost-pill {
      background: black;
      border: 1px solid var(--border);
      color: var(--off-white);
      padding: 1rem 2.8rem;
      border-radius: 100px;
      font-size: 0.92rem;
      font-weight: 500;
      transition: border-color 0.3s, color 0.3s;
    }

    .btn-ghost-pill:hover {
      border-color: var(--grey);
      color: var(--white);
    }

    /* Scroll hint */
    .scroll-hint {
      position: absolute;
      bottom: 2.5rem;
      left: 4rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      opacity: 0;
      transition: opacity 0.6s ease 1.5s;
    }

    .scroll-hint.visible {
      opacity: 1;
    }

    .scroll-line {
      width: 32px;
      height: 1px;
      background: var(--border);
      position: relative;
      overflow: hidden;
    }

    .scroll-line::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: var(--lime);
      animation: scrollAnim 2s ease infinite;
    }

    @keyframes scrollAnim {
      0% {
        left: -100%
      }

      100% {
        left: 100%
      }
    }

    .scroll-text {
      font-size: 0.72rem;
      color: var(--grey);
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* ===================== ROAD ANIMATION ===================== */
    .road-section {
      height: 80px;
      background: #0a0a0a;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      position: relative;
      overflow: hidden;
    }

    .road-dashes {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(90deg,
          transparent 0px,
          transparent 60px,
          rgba(200, 241, 53, 0.06) 60px,
          rgba(200, 241, 53, 0.06) 120px);
      animation: roadMove 1.5s linear infinite;
    }

    @keyframes roadMove {
      from {
        background-position: 0 0
      }

      to {
        background-position: -120px 0
      }
    }

    @keyframes carDrive {
      from {
        left: -120px
      }

      to {
        left: 105%
      }
    }

    .road-car {
      position: absolute;
      bottom: 18px;
      font-size: 2.2rem;
      filter: drop-shadow(0 4px 14px rgba(200, 241, 53, 0.4));
      animation: carDrive 9s linear infinite 0s;
    }

    .road-car-2 {
      position: absolute;
      bottom: 18px;
      font-size: 2.2rem;
      filter: drop-shadow(0 4px 14px rgba(200, 241, 53, 0.4));
      animation: carDrive 9s linear infinite -1.5s;
    }

    .road-car-3 {
      position: absolute;
      bottom: 18px;
      font-size: 2.2rem;
      filter: drop-shadow(0 4px 14px rgba(200, 241, 53, 0.4));
      animation: carDrive 9s linear infinite -3s;
    }

    .road-car-4 {
      position: absolute;
      bottom: 18px;
      font-size: 2.2rem;
      filter: drop-shadow(0 4px 14px rgba(200, 241, 53, 0.4));
      animation: carDrive 9s linear infinite -4.5s;
    }

    .road-car-5 {
      position: absolute;
      bottom: 18px;
      font-size: 2.2rem;
      filter: drop-shadow(0 4px 14px rgba(200, 241, 53, 0.4));
      animation: carDrive 9s linear infinite -6s;
    }

    .road-car-6 {
      position: absolute;
      bottom: 18px;
      font-size: 2.2rem;
      filter: drop-shadow(0 4px 14px rgba(200, 241, 53, 0.4));
      animation: carDrive 9s linear infinite -7.5s;
    }

    /* ===================== SECTION COMMONS ===================== */
    .section-tag {
      font-family: 'Satoshi', monospace;
      font-size: 0.72rem;
      color: var(--lime);
      letter-spacing: 3px;
      text-transform: uppercase;
      font-weight: 500;
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }


    /* ── City Autocomplete ── */
    .sf-wrap {
      position: relative;
    }

    .ac-dropdown {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      z-index: 9000;
      background: #111;
      border: 1px solid #2a2a2a;
      border-radius: 14px;
      max-height: 230px;
      overflow-y: auto;
      display: none;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
    }

    .ac-dropdown.open {
      display: block;
    }

    .ac-dropdown::-webkit-scrollbar {
      width: 3px;
    }

    .ac-dropdown::-webkit-scrollbar-thumb {
      background: #2a2a2a;
      border-radius: 3px;
    }

    .ac-item {
      padding: 0.7rem 1rem;
      font-size: 0.85rem;
      color: #888;
      cursor: pointer;
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
      transition: background 0.12s, color 0.12s;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .ac-item:last-child {
      border-bottom: none;
    }

    .ac-item:hover,
    .ac-item.ac-selected {
      background: #1a1a1a;
      color: #fff;
    }

    .ac-item b {
      color: #C8F135;
      font-weight: 600;
    }


    .section-tag::before {
      content: '';
      width: 20px;
      height: 1px;
      background: var(--lime);
    }

    .section-heading {
      font-family: 'Clash Display', sans-serif;
      font-size: clamp(2.8rem, 5vw, 5rem);
      font-weight: 700;
      line-height: 0.95;
      letter-spacing: -0.5px;
    }

    .section-heading .accent {
      color: var(--lime);
    }

    /* Reveal animation */
    .reveal {
      opacity: 0;
      transform: translateY(36px);
      transition: opacity 0.75s ease, transform 0.75s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .reveal-delay-1 {
      transition-delay: 0.1s;
    }

    .reveal-delay-2 {
      transition-delay: 0.2s;
    }

    .reveal-delay-3 {
      transition-delay: 0.3s;
    }

    /* ===================== MARQUEE STRIP ===================== */
    .marquee-wrap {
      background: var(--lime);
      padding: 0.9rem 0;
      overflow: hidden;
      border-top: 1px solid rgba(0, 0, 0, 0.15);
      border-bottom: 1px solid rgba(0, 0, 0, 0.15);
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee 20s linear infinite;
    }

    .marquee-item {
      font-family: 'Clash Display', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--black);
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding-right: 1.5rem;
    }

    .marquee-sep {
      font-size: 0.5rem;
      opacity: 0.4;
    }

    @keyframes marquee {
      from {
        transform: translateX(0)
      }

      to {
        transform: translateX(-50%)
      }
    }

    /* ===================== SEARCH SECTION ===================== */
    .search-section {
      background: white;
      padding: 8rem 4rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
      align-items: center;
    }

    .search-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 2.5rem;
      position: relative;
      overflow: hidden;
    }

    .search-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--lime), transparent);
    }

    .search-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .s-label {
      font-size: 0.7rem;
      color: var(--grey);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      font-weight: 500;
    }

    .s-input {
      width: 100%;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      color: var(--white);
      padding: 0.9rem 1rem;
      border-radius: 12px;
      font-size: 0.9rem;
      font-family: 'Satoshi', sans-serif;
      outline: none;
      transition: border-color 0.3s, background 0.3s;
    }

    .s-input::placeholder {
      color: white;
    }

    .s-input:focus {
      border-color: var(--lime);
      background: rgba(200, 241, 53, 0.03);
    }

    .s-search-btn {
      width: 100%;
      margin-top: 0.5rem;
      background: var(--lime);
      color: var(--black);
      border: none;
      padding: 1rem;
      border-radius: 12px;
      font-size: 0.92rem;
      font-weight: 700;
      font-family: 'Clash Display', sans-serif;
      letter-spacing: 1px;
      transition: opacity 0.3s, transform 0.2s;
    }

    .s-search-btn:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    /* ===================== HOW IT WORKS ===================== */
    .how-section {
      padding: 8rem 4rem;
      background: #090909;
      border-top: 1px solid var(--border);
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 5rem;
    }

    .step-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 2.5rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.4s, transform 0.3s;
    }

    .step-card:hover {
      border-color: rgba(200, 241, 53, 0.3);
      transform: translateY(-4px);
    }

    .step-card::after {
      content: '';
      position: absolute;
      bottom: -60px;
      right: -60px;
      width: 150px;
      height: 150px;
      background: radial-gradient(circle, rgba(200, 241, 53, 0.06), transparent 70%);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.4s;
    }

    .step-card:hover::after {
      opacity: 1;
    }

    .step-num {
      font-family: 'Clash Display', sans-serif;
      font-size: 5.5rem;
      font-weight: 700;
      color: #95CFB0;
      position: absolute;
      top: 0.5rem;
      right: 1rem;
      line-height: 1;
      pointer-events: none;
      transition: color 0.4s;
    }

    .step-card:hover .step-num {
      color: rgba(200, 241, 53, 0.05);
    }

    .step-icon-wrap {
      width: 48px;
      height: 48px;
      background: rgba(200, 241, 53, 0.08);
      border: 1px solid rgba(200, 241, 53, 0.15);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      margin-bottom: 2rem;
    }

    .step-title {
      font-family: 'Clash Display', sans-serif;
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 0.8rem;
    }

    .step-desc {
      color: var(--grey);
      font-size: 0.88rem;
      line-height: 1.75;
    }

    /* ===================== WALLET SECTION ===================== */
    .wallet-section {
      background-color: white;
      padding: 8rem 4rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
      border-top: 1px solid var(--border);
    }

    .wallet-ui {
      background: var(--card);
      border: 1px solid var(--border);
