    .m-label {
      font-size: 0.68rem;
      color: var(--grey);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 6px;
      display: block;
    }

    .m-input {
      width: 100%;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      color: var(--white);
      padding: 0.85rem 1rem;
      border-radius: 10px;
      font-size: 0.88rem;
      font-family: 'Satoshi', sans-serif;
      outline: none;
      transition: border-color 0.3s;
    }

    .m-input::placeholder {
      color: #3a3a3a;
    }

    .m-input:focus {
      border-color: var(--lime);
    }

    .m-submit {
      width: 100%;
      background: var(--lime);
      color: var(--black);
      border: none;
      padding: 0.95rem;
      border-radius: 10px;
      font-size: 0.92rem;
      font-weight: 700;
      font-family: 'Clash Display', sans-serif;
      letter-spacing: 1px;
      margin-top: 0.5rem;
      margin-bottom: 1.2rem;
      transition: opacity 0.3s;
    }

    .m-submit:hover {
      opacity: 0.88;
    }

    .m-divider {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin: 1.2rem 0;
      color: #444;
      font-size: 0.75rem;
    }

    .m-divider::before,
    .m-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .m-google {
