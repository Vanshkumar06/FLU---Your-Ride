    /* ===================== MODAL ===================== */
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.9);
      backdrop-filter: blur(12px);
      z-index: 5000;
      align-items: center;
      justify-content: center;
    }

