      display: flex;
    }

    .modal-panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 2.5rem;
      width: 100%;
      max-width: 400px;
      margin: 1rem;
      position: relative;
      animation: panelIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes panelIn {
      from {
        opacity: 0;
        transform: translateY(24px) scale(0.97)
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1)
      }
    }

    .modal-close-btn {
      position: absolute;
      top: 1.2rem;
      right: 1.2rem;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #1a1a1a;
      border: 1px solid var(--border);
