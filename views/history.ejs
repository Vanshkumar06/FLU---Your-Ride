<%- include('./partials/header') %>

<style>
@import url('https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@300,400,500,700&display=swap');

:root {
  --lime:   #C8F135;
  --mint:   #95CFB0;
  --black:  #080808;
  --white:  #ffffff;
  --card:   #101010;
  --border: #1e1e1e;
  --grey:   #888;
  --dark:   #1c1c1c;
  --red:    #ff4040;
  --orange: #ff8c00;
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }
body { background:var(--black); color:var(--white); font-family:'Satoshi',sans-serif; overflow-x:hidden; min-height:100vh; }
a { text-decoration:none; color:inherit; }
button { font-family:'Satoshi',sans-serif; cursor:pointer; }

body::after {
  content:''; position:fixed; inset:0; pointer-events:none; z-index:9999;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
  opacity:0.03;
}

/* ══ NAVBAR ══ */
.nav {
  position:fixed; top:1.5rem; left:50%; transform:translateX(-50%);
  z-index:1000; width:calc(100% - 4rem); max-width:1100px;
  display:flex; align-items:center; justify-content:space-between;
  background:rgba(8,8,8,0.8); backdrop-filter:blur(24px);
  border:1px solid var(--border); border-radius:100px;
  padding:0.65rem 0.65rem 0.65rem 1.8rem; transition:transform .4s;
}
.nav.hidden { transform:translateX(-50%) translateY(-140%); }
.nav-logo { font-family:'Clash Display',sans-serif; font-size:1.25rem; font-weight:700; letter-spacing:4px; color:var(--lime); }
.nav-links { display:flex; gap:.2rem; position:absolute; left:50%; transform:translateX(-50%); }
.nav-links a { font-size:.8rem; color:var(--grey); padding:.45rem 1rem; border-radius:100px; transition:color .2s,background .2s; }
.nav-links a:hover { color:var(--white); background:var(--dark); }
.nav-links a.active { color:var(--black); background:var(--lime); }
.nav-chip { display:flex; align-items:center; gap:.5rem; background:var(--dark); border-radius:100px; padding:.3rem .9rem .3rem .4rem; }
.nav-av { width:24px; height:24px; border-radius:50%; background:var(--lime); color:var(--black); font-size:.68rem; font-weight:700; display:flex; align-items:center; justify-content:center; }
.nav-uname { font-size:.78rem; color:var(--white); font-weight:500; }
.btn-ghost-nav { background:transparent; border:none; color:var(--grey); font-size:.8rem; padding:.45rem .9rem; border-radius:100px; transition:color .2s; }
.btn-ghost-nav:hover { color:var(--white); }

/* ══ BACK PILL ══ */
.back-pill-wrap { padding:6.5rem 4rem 0; }
.back-pill {
  display:inline-flex; align-items:center; gap:.5rem;
  background:rgba(255,255,255,.04); border:1px solid var(--border);
  color:var(--grey); font-size:.78rem; padding:.4rem 1rem; border-radius:100px;
  opacity:0; transform:translateY(10px); animation:fadeUp .6s ease .2s forwards;
  transition:color .2s,border-color .2s;
}
.back-pill:hover { color:var(--white); border-color:#444; }

/* ══ HERO ══ */
.hero {
  padding:2rem 4rem 3rem; position:relative; overflow:hidden;
  border-bottom:1px solid var(--border); min-height:32vh;
  display:flex; flex-direction:column; justify-content:flex-end;
}
.hero-glow { position:absolute; top:-20%; right:-5%; width:600px; height:500px; background:radial-gradient(ellipse,rgba(149,207,176,.07) 0%,transparent 65%); pointer-events:none; }
.hero-glow2 { position:absolute; bottom:-30%; left:5%; width:500px; height:400px; background:radial-gradient(ellipse,rgba(200,241,53,.04) 0%,transparent 65%); pointer-events:none; }
.hero-lines { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.hero-lines span { position:absolute; height:1px; background:linear-gradient(90deg,transparent,rgba(149,207,176,.1),transparent); animation:hline 4s linear infinite; opacity:0; }
.hero-lines span:nth-child(1){ top:25%; width:40%; animation-delay:0s; }
.hero-lines span:nth-child(2){ top:60%; width:60%; animation-delay:1.5s; }
.hero-lines span:nth-child(3){ top:80%; width:30%; animation-delay:2.8s; }
@keyframes hline { 0%{left:-60%;opacity:0} 10%{opacity:1} 90%{opacity:.5} 100%{left:110%;opacity:0} }

.hero-h1 { font-family:'Clash Display',sans-serif; font-size:clamp(3rem,8vw,7rem); font-weight:700; line-height:.9; letter-spacing:-.5px; }
.hero-h1 .word { display:inline-block; overflow:hidden; margin-right:.1em; }
.hero-h1 .word span { display:inline-block; transform:translateY(110%); transition:transform .8s cubic-bezier(.16,1,.3,1); }
.hero-h1 .lime { color:var(--lime); }
.hero-h1 .mint { color:var(--mint); }
.hero-sub { color:var(--grey); font-size:.92rem; line-height:1.8; margin-top:1.5rem; opacity:0; animation:fadeUp .6s ease 1s forwards; }
@keyframes fadeUp { to{opacity:1;transform:translateY(0)} }

/* ══ STATS ROW ══ */
.stats-row {
  max-width:1100px; margin:2.5rem auto 0; padding:0 4rem;
  display:grid; grid-template-columns:repeat(4,1fr); gap:1rem;
  opacity:0; animation:fadeUp .5s ease .3s forwards;
}
.stat-card {
  background:var(--card); border:1px solid var(--border);
  border-radius:16px; padding:1.2rem 1.4rem;
  position:relative; overflow:hidden;
}
.stat-card::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(200,241,53,.12),transparent); }
.stat-num { font-family:'Clash Display',sans-serif; font-size:2rem; font-weight:700; line-height:1; }
.stat-num.lime { color:var(--lime); }
.stat-num.mint { color:var(--mint); }
.stat-num.orange { color:var(--orange); }
.stat-lbl { font-size:.62rem; color:var(--grey); letter-spacing:2px; text-transform:uppercase; margin-top:.3rem; }

/* ══ TABS ══ */
.tabs-wrap {
  max-width:1100px; margin:2rem auto 0; padding:0 4rem;
  opacity:0; animation:fadeUp .5s ease .4s forwards;
}
.tabs {
  display:inline-flex; background:var(--card);
  border:1px solid var(--border); border-radius:14px; padding:.3rem; gap:.2rem;
}
.tab {
  padding:.55rem 1.4rem; border-radius:10px; font-size:.82rem;
  font-weight:600; color:var(--grey); background:transparent; border:none;
  transition:color .2s, background .2s;
  display:flex; align-items:center; gap:.5rem;
}
.tab:hover { color:var(--white); }
.tab.active { background:var(--lime); color:var(--black); -webkit-text-fill-color:var(--black); }
.tab-count {
  font-size:.65rem; font-weight:700; padding:.1rem .45rem;
  border-radius:100px; background:rgba(255,255,255,.08);
  color:inherit; letter-spacing:.5px;
}
.tab.active .tab-count { background:rgba(0,0,0,.15); color:var(--black); -webkit-text-fill-color:var(--black); }

/* ══ CONTENT AREA ══ */
.content {
  max-width:1100px; margin:1.5rem auto 0; padding:0 4rem 5rem;
}

/* ══ RIDE CARDS GRID ══ */
.rides-grid { display:flex; flex-direction:column; gap:1rem; }

/* ── PUBLISHED RIDE CARD ── */
.ride-card {
  background:var(--card); border:1px solid var(--border);
  border-radius:20px; padding:1.6rem;
  display:grid; grid-template-columns:1fr auto;
  gap:1.2rem; align-items:center;
  position:relative; overflow:hidden;
  opacity:0; transform:translateY(16px);
  transition:opacity .5s ease, transform .5s cubic-bezier(.16,1,.3,1), border-color .3s, box-shadow .3s;
}
.ride-card.visible { opacity:1; transform:translateY(0); }
.ride-card::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:transparent; transition:background .3s; }
.ride-card:hover { border-color:rgba(149,207,176,.25); box-shadow:0 8px 40px rgba(0,0,0,.4); }
.ride-card:hover::before { background:linear-gradient(90deg,transparent,var(--mint),transparent); }

/* Status stripe on left edge */
.ride-card::after { content:''; position:absolute; top:0; left:0; bottom:0; width:3px; border-radius:20px 0 0 20px; }
.ride-card.status-active::after   { background:var(--lime); }
.ride-card.status-completed::after{ background:var(--mint); }
.ride-card.status-cancelled::after{ background:var(--red); }

.rc-left { display:flex; flex-direction:column; gap:.85rem; }

/* Route row */
.rc-route { display:flex; align-items:center; gap:.7rem; }
.rc-city { font-family:'Clash Display',sans-serif; font-size:1.35rem; font-weight:700; letter-spacing:-.3px; }
.rc-mid { flex:1; display:flex; align-items:center; gap:.35rem; max-width:90px; }
.rc-line { flex:1; height:1px; background:linear-gradient(90deg,var(--border),rgba(149,207,176,.4),var(--border)); }
.rc-arrow { color:var(--mint); font-size:.85rem; }
.rc-dur { font-size:.65rem; color:var(--grey); background:var(--dark); padding:.18rem .5rem; border-radius:100px; letter-spacing:1px; text-transform:uppercase; white-space:nowrap; }

/* Meta row */
.rc-meta { display:flex; flex-wrap:wrap; gap:1rem; }
.rc-mi { display:flex; align-items:center; gap:.3rem; font-size:.76rem; color:var(--grey); }
.rc-mi.lime { color:var(--lime); }
.rc-mi.mint { color:var(--mint); }
.rc-mi.red  { color:var(--red); }

/* Driver/passenger info */
.rc-person { display:flex; align-items:center; gap:.55rem; }
.rc-av { width:28px; height:28px; border-radius:50%; background:var(--mint); color:var(--black); font-size:.72rem; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.rc-av.lime-bg { background:var(--lime); }
.rc-pname { font-size:.8rem; font-weight:600; }
.rc-psub  { font-size:.67rem; color:var(--grey); }

/* Tags */
.rc-tags { display:flex; gap:.35rem; flex-wrap:wrap; }
.rc-tag { font-size:.62rem; letter-spacing:1px; text-transform:uppercase; padding:.16rem .5rem; border-radius:6px; border:1px solid var(--border); color:var(--grey); }
.rc-tag.lime { color:var(--lime); border-color:rgba(200,241,53,.2); background:rgba(200,241,53,.05); }
.rc-tag.mint { color:var(--mint); border-color:rgba(149,207,176,.2); background:rgba(149,207,176,.05); }
.rc-tag.red  { color:var(--red);  border-color:rgba(255,64,64,.2);   background:rgba(255,64,64,.05); }
.rc-tag.orange { color:var(--orange); border-color:rgba(255,140,0,.2); background:rgba(255,140,0,.05); }

/* Right column */
.rc-right { display:flex; flex-direction:column; align-items:flex-end; gap:.8rem; min-width:130px; }
.rc-price { font-family:'Clash Display',sans-serif; font-size:2rem; font-weight:700; color:var(--lime); letter-spacing:-1px; line-height:1; text-align:right; }
.rc-price-lbl { font-size:.67rem; color:var(--grey); text-align:right; margin-top:.08rem; }
.rc-seats-pill { display:flex; align-items:center; gap:.35rem; font-size:.7rem; color:var(--grey); }
.rc-sdot { width:6px; height:6px; border-radius:50%; flex-shrink:0; }
.rc-sdot.green  { background:var(--lime); animation:blink 1.8s ease infinite; }
.rc-sdot.grey   { background:#333; }
.rc-sdot.red    { background:var(--red); }
@keyframes blink { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(1.4)} }

/* Action buttons */
.rc-actions { display:flex; gap:.4rem; flex-wrap:wrap; justify-content:flex-end; }
.btn-cancel {
  background:transparent; border:1px solid rgba(255,64,64,.25);
  color:var(--red); padding:.42rem .9rem; border-radius:100px;
  font-size:.72rem; font-weight:600;
  transition:background .2s, border-color .2s;
}
.btn-cancel:hover { background:rgba(255,64,64,.08); border-color:var(--red); }
.btn-view {
  background:transparent; border:1px solid var(--border);
  color:var(--grey); padding:.42rem .9rem; border-radius:100px;
  font-size:.72rem; font-weight:600;
  transition:border-color .2s, color .2s;
}
.btn-view:hover { border-color:var(--mint); color:var(--mint); }

/* ══ SKELETON ══ */
.skel { background:var(--card); border:1px solid var(--border); border-radius:20px; padding:1.6rem; display:flex; flex-direction:column; gap:.9rem; }
.sk { background:linear-gradient(90deg,#151515 25%,#1d1d1d 50%,#151515 75%); background-size:300% 100%; animation:shimmer 1.6s infinite; border-radius:6px; }
@keyframes shimmer { 0%{background-position:300% 0} 100%{background-position:-300% 0} }
.sk-h { height:28px; width:50%; }
.sk-m { height:12px; width:70%; }
.sk-s { height:11px; width:35%; }

/* ══ EMPTY STATE ══ */
.empty {
  display:flex; flex-direction:column; align-items:center;
  text-align:center; padding:6rem 2rem;
  opacity:0; animation:fadeUp .5s ease .3s forwards;
}
.empty-ico { font-size:3.5rem; margin-bottom:1.4rem; opacity:.3; }
.empty-h { font-family:'Clash Display',sans-serif; font-size:1.8rem; font-weight:700; margin-bottom:.65rem; }
.empty-p { color:var(--grey); font-size:.87rem; line-height:1.75; max-width:280px; margin-bottom:2rem; }
.btn-lime-pill { background:var(--lime); color:var(--black); border:none; padding:.78rem 2rem; border-radius:100px; font-size:.84rem; font-weight:700; font-family:'Clash Display',sans-serif; -webkit-text-fill-color:var(--black); transition:opacity .2s,transform .2s; }
.btn-lime-pill:hover { opacity:.88; transform:scale(.98); }

/* ══ AUTH GATE ══ */
.auth-gate { display:none; flex-direction:column; align-items:center; text-align:center; padding:6rem 2rem; }
.auth-gate.show { display:flex; }
.btn-ghost-pill { background:transparent; border:1px solid var(--border); color:var(--white); padding:.78rem 2rem; border-radius:100px; font-size:.84rem; transition:border-color .2s; }
.btn-ghost-pill:hover { border-color:var(--grey); }

/* ══ CANCEL CONFIRM MODAL ══ */
.backdrop { display:none; position:fixed; inset:0; background:rgba(0,0,0,.92); backdrop-filter:blur(18px); z-index:5000; align-items:center; justify-content:center; }
.backdrop.open { display:flex; }
.mpanel { background:var(--card); border:1px solid var(--border); border-radius:24px; padding:2.2rem; width:100%; max-width:400px; margin:1rem; position:relative; animation:panelIn .38s cubic-bezier(.16,1,.3,1); text-align:center; }
@keyframes panelIn { from{opacity:0;transform:translateY(26px) scale(.96)} to{opacity:1;transform:none} }
.mpanel::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(255,64,64,.4),transparent); border-radius:24px 24px 0 0; }
.mclose { position:absolute; top:1rem; right:1rem; width:28px; height:28px; border-radius:50%; background:#1a1a1a; border:1px solid var(--border); color:var(--grey); font-size:.75rem; display:flex; align-items:center; justify-content:center; }
.mclose:hover { color:var(--white); }
.m-ico { font-size:2.5rem; margin-bottom:1rem; }
.m-title { font-family:'Clash Display',sans-serif; font-size:1.5rem; font-weight:700; margin-bottom:.5rem; }
.m-desc { color:var(--grey); font-size:.82rem; line-height:1.7; margin-bottom:1.5rem; }
.m-desc b { color:var(--red); }
.m-actions { display:flex; gap:.6rem; }
.btn-red { flex:1; background:rgba(255,64,64,.1); border:1px solid rgba(255,64,64,.3); color:var(--red); padding:.8rem; border-radius:10px; font-size:.84rem; font-weight:700; font-family:'Satoshi',sans-serif; transition:background .2s; }
.btn-red:hover { background:rgba(255,64,64,.18); }
.btn-outline { flex:1; background:transparent; border:1px solid var(--border); color:var(--grey); padding:.8rem; border-radius:10px; font-size:.84rem; transition:border-color .2s,color .2s; }
.btn-outline:hover { border-color:var(--grey); color:var(--white); }

/* Responsive */
@media(max-width:960px){
  .nav { width:calc(100% - 2rem); }
  .nav-links { display:none; }
  .hero,.back-pill-wrap,.stats-row,.tabs-wrap,.content { padding-left:1.5rem; padding-right:1.5rem; }
  .stats-row { grid-template-columns:1fr 1fr; }
  .ride-card { grid-template-columns:1fr; }
  .rc-right { flex-direction:row; align-items:center; justify-content:space-between; min-width:unset; }
}
</style>

<!-- NAVBAR -->
<nav class="nav" id="nav">
  <a href="/" class="nav-logo">FLU</a>
  <div class="nav-links">
    <a href="/">Home</a>
    <a href="/rides/search">Find Ride</a>
    <a href="/rides/publish">Publish</a>
    <a href="/history" class="active">My Rides</a>
    <a href="/wallet">Wallet</a>
  </div>
  <div class="nav-chip" id="nav-chip">
    <div class="nav-av" id="nav-av">A</div>
    <span class="nav-uname" id="nav-uname">User</span>
    <button class="btn-ghost-nav" onclick="logout()">Logout</button>
  </div>
</nav>

<!-- HERO -->
<section class="hero" style="background-image: url('../images/bg.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat;">
  <br>
  <br>
  <br>
  <br>
  <br>
  <a href="/" >← Back to Home</a>
  <div class="hero-glow"></div>
  <div class="hero-glow2"></div>
  <div class="hero-lines"><span></span><span></span><span></span></div>
  <h1 class="hero-h1" id="hero-h1">
    <span class="word"><span>MY</span></span>
    <span class="word lime"><span>RIDES</span></span>
    <span class="word mint"><span>&amp;</span></span>
    <br>
    <span class="word"><span>HISTORY.</span></span>
  </h1>
  <p class="hero-sub" style="color: #080808;">All your published and booked rides in one place.</p>

<!-- STATS -->
<div class="stats-row" id="stats-row">
  <div class="stat-card">
    <div class="stat-num lime" id="stat-published">—</div>
    <div class="stat-lbl">Rides Published</div>
  </div>
  <div class="stat-card">
    <div class="stat-num mint" id="stat-booked">—</div>
    <div class="stat-lbl">Rides Booked</div>
  </div>
  <div class="stat-card">
    <div class="stat-num lime" id="stat-active">—</div>
    <div class="stat-lbl">Currently Active</div>
  </div>
  <div class="stat-card">
    <div class="stat-num orange" id="stat-cancelled">—</div>
    <div class="stat-lbl">Cancelled</div>
  </div>
</div>

<!-- TABS -->
<div class="tabs-wrap">
  <div class="tabs">
    <button class="tab active" id="tab-published" onclick="switchTab('published')">
      🚗 Published
      <span class="tab-count" id="tc-published">0</span>
    </button>
    <button class="tab" id="tab-booked" onclick="switchTab('booked')">
      🎫 Booked
      <span class="tab-count" id="tc-booked">0</span>
    </button>
  </div>
</div>

<!-- CONTENT -->
<div class="content">

  <!-- Auth gate -->
  <div class="auth-gate show" id="auth-gate">
    <div class="empty-ico">🔐</div>
    <h2 class="empty-h">Login to View Rides</h2>
    <p class="empty-p">Your ride history lives here.</p>
    <div style="display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center;">
      <button class="btn-lime-pill" onclick="location.href='/'">Go to Homepage</button>
    </div>
  </div>

  <!-- Published tab -->
  <div id="panel-published" style="display:none; ">
    <div class="rides-grid" id="list-published"></div>
  </div>

  <!-- Booked tab -->
  <div id="panel-booked" style="display:none;">
    <div class="rides-grid" id="list-booked"></div>
  </div>

</div>
</section>

<!-- CANCEL CONFIRM MODAL -->
<div class="backdrop" id="cancel-modal">
  <div class="mpanel">
    <button type="button" class="mclose" onclick="closeCancelModal()">✕</button>
    <div class="m-ico">⚠️</div>
    <div class="m-title">CANCEL THIS RIDE?</div>
    <div class="m-desc" id="cancel-desc">
      All booked passengers will be notified by email.
      <br><br>
      <span id="cancel-fine-note"></span>
    </div>
    <div class="m-actions">
      <button class="btn-red" onclick="confirmCancel()">Yes, Cancel</button>
      <button class="btn-outline" onclick="closeCancelModal()">Keep Ride</button>
    </div>
  </div>
</div>

<script>
// ── STATE ──
let publishedRides = [];
let bookedRides    = [];
let cancelRideId   = null;
let cancellationsThisMonth = 0;

// ── NAVBAR ──
let lastY = 0;
window.addEventListener('scroll', () => {
  const y = window.scrollY;
  document.getElementById('nav').classList.toggle('hidden', y > lastY && y > 100);
  lastY = y;
});

// ── HERO ANIMATION ──
window.addEventListener('load', () => {
  document.querySelectorAll('.hero-h1 .word span').forEach((s, i) => {
    setTimeout(() => {
      s.style.transition = 'transform .85s cubic-bezier(.16,1,.3,1)';
      s.style.transform  = 'translateY(0)';
    }, 300 + i * 110);
  });
});

// ── INIT ──
document.addEventListener('DOMContentLoaded', async () => {
  const user = getUser();
  if (!user) return; // auth gate stays visible

  document.getElementById('auth-gate').classList.remove('show');
  renderNav(user);

  // Show skeleton while loading
  showSkeleton('published');
  showSkeleton('booked');
  document.getElementById('panel-published').style.display = 'block';

  // Fetch both in parallel
  const token = localStorage.getItem('flu_token');
  const headers = { Authorization: `Bearer ${token}` };

  const [pubRes, bookRes, statusRes] = await Promise.allSettled([
    fetch('/api/rides/user/published', { headers }),
    fetch('/api/rides/user/booked',    { headers }),
    fetch('/api/driver/status',        { headers })
  ]);

  // Published rides
  if (pubRes.status === 'fulfilled' && pubRes.value.ok) {
    const d = await pubRes.value.json();
    publishedRides = d.rides || [];
  }

  // Booked rides
  if (bookRes.status === 'fulfilled' && bookRes.value.ok) {
    const d = await bookRes.value.json();
    bookedRides = (d.bookings || []).map(b => b.rideId).filter(Boolean);
  }

  // Driver status (for cancel fine check)
  if (statusRes.status === 'fulfilled' && statusRes.value.ok) {
    const d = await statusRes.value.json();
    cancellationsThisMonth = d.cancellationsThisMonth || 0;
  }

  updateStats();
  renderTab('published');
});

// ── STATS ──
function updateStats() {
  const active    = publishedRides.filter(r => r.rideStatus === 'active').length;
  const cancelled = publishedRides.filter(r => r.rideStatus === 'cancelled').length +
                    bookedRides.filter(r => r?.rideStatus === 'cancelled').length;

  document.getElementById('stat-published').textContent = publishedRides.length;
  document.getElementById('stat-booked').textContent    = bookedRides.length;
  document.getElementById('stat-active').textContent    = active;
  document.getElementById('stat-cancelled').textContent = cancelled;

  document.getElementById('tc-published').textContent   = publishedRides.length;
  document.getElementById('tc-booked').textContent      = bookedRides.length;
}

// ── TABS ──
function switchTab(tab) {
  ['published','booked'].forEach(t => {
    document.getElementById('tab-' + t).classList.toggle('active', t === tab);
    document.getElementById('panel-' + t).style.display = t === tab ? 'block' : 'none';
  });
  renderTab(tab);
}

// ── SKELETON ──
function showSkeleton(tab) {
  const list = document.getElementById('list-' + tab);
  list.innerHTML = [1,2,3].map(() => `
    <div class="skel">
      <div class="sk sk-h"></div>
      <div class="sk sk-m"></div>
      <div class="sk sk-s"></div>
    </div>
  `).join('');
}

// ── RENDER TAB ──
function renderTab(tab) {
  const rides = tab === 'published' ? publishedRides : bookedRides;
  const list  = document.getElementById('list-' + tab);
  list.innerHTML = '';

  if (!rides.length) {
    list.innerHTML = `
      <div class="empty">
        <div class="empty-ico">${tab === 'published' ? '🚗' : '🎫'}</div>
        <h3 class="empty-h">No ${tab === 'published' ? 'published' : 'booked'} rides yet</h3>
        <p class="empty-p">${tab === 'published'
          ? 'Share your journey and cover your fuel costs.'
          : 'Find a ride and book your seat in seconds.'}</p>
        <button class="btn-lime-pill" onclick="location.href='${tab === 'published' ? '/rides/publish' : '/rides/search'}'">
          ${tab === 'published' ? 'Publish a Ride →' : 'Find a Ride →'}
        </button>
      </div>`;
    return;
  }

  rides.forEach((ride, i) => {
    if (!ride) return;
    const card = buildCard(ride, tab);
    list.appendChild(card);
    setTimeout(() => card.classList.add('visible'), 50 + i * 70);
  });
}

// ── BUILD CARD ──
function buildCard(ride, tab) {
  const card = document.createElement('div');
  const status = ride.rideStatus || 'active';
  card.className = `ride-card status-${status}`;

  const from   = ride.fromLocation || ride.from || '—';
  const to     = ride.toLocation   || ride.to   || '—';
  const price  = ride.pricePerSeat || ride.price || 0;
  const seats  = ride.seatsAvailable ?? ride.seats ?? 0;
  const km     = ride.distanceKm   || null;
  const dur    = ride.duration     || (km ? eta(km) : '—');
  const dt     = ride.departureTime || '—';
  const dateStr = ride.date
    ? new Date(ride.date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' })
    : '—';

  // Status badge
  const statusTag = {
    active:    '<span class="rc-tag lime">● Active</span>',
    completed: '<span class="rc-tag mint">✓ Completed</span>',
    cancelled: '<span class="rc-tag red">✕ Cancelled</span>'
  }[status] || '';

  // Amenity tags
  const amenityTags = [];
  if (ride.amenities?.ac)      amenityTags.push('<span class="rc-tag lime">AC</span>');
  if (ride.amenities?.music)   amenityTags.push('<span class="rc-tag">Music</span>');
  if (ride.amenities?.luggage) amenityTags.push('<span class="rc-tag">Luggage</span>');
  if (ride.amenities?.ladies)  amenityTags.push('<span class="rc-tag mint">Ladies Only</span>');

  // Seats dot color
  const dotClass = status === 'cancelled' ? 'red' : seats > 0 ? 'green' : 'grey';

  // Cashback (for booked rides — passenger gets it)
  const cashback = km ? '₹' + (km * 0.5).toFixed(0) + ' cashback earned' : null;

  // Action buttons — only for published active rides
  const actions = tab === 'published' && status === 'active'
    ? `<button class="btn-cancel" onclick="openCancelModal('${ride._id}')">Cancel Ride</button>`
    : '';

  card.innerHTML = `
    <div class="rc-left">
      <div class="rc-route">
        <span class="rc-city" style="color: white; font-family: Times New Roman;">${from}</span>
        <div class="rc-mid">
          <div class="rc-line"></div>
          <span class="rc-arrow">→</span>
          <div class="rc-line"></div>
        </div>
        <span class="rc-city" style="color: white; font-family: Times New Roman;">${to}</span>
        <span class="rc-dur">${dur}${km ? ' · ' + km + ' km' : ''}</span>
      </div>

      <div class="rc-meta">
        <div class="rc-mi">🕐 ${dt}</div>
        <div class="rc-mi">📅 ${dateStr}</div>
        ${km ? `<div class="rc-mi mint">📍 ${km} km</div>` : ''}
        ${tab === 'booked' && cashback ? `<div class="rc-mi lime">💰 ${cashback}</div>` : ''}
      </div>

      <div class="rc-tags">
        ${statusTag}
        ${amenityTags.join('')}
        <span class="rc-tag">Instant Confirm</span>
      </div>

      ${actions ? `<div class="rc-actions">${actions}</div>` : ''}
    </div>

    <div class="rc-right">
      <div>
        <div class="rc-price">₹${price}</div>
        <div class="rc-price-lbl">per seat</div>
      </div>
      <div class="rc-seats-pill">
        <span class="rc-sdot ${dotClass}"></span>
        ${status === 'cancelled' ? 'Cancelled' : seats + ' seat' + (seats !== 1 ? 's' : '') + (tab === 'published' ? ' left' : ' booked')}
      </div>
    </div>
  `;

  return card;
}

function eta(km) {
  const h = km / 60;
  if (h < 1) return '~' + Math.round(h * 60) + 'm';
  const hh = Math.floor(h), mm = Math.round((h - hh) * 60);
  return mm > 0 ? '~' + hh + 'h ' + mm + 'm' : '~' + hh + 'h';
}

// ── CANCEL FLOW ──
function openCancelModal(rideId) {
  cancelRideId = rideId;
  const fineNote = document.getElementById('cancel-fine-note');
  if (cancellationsThisMonth >= 1) {
    fineNote.innerHTML = `<b>⚠️ ₹100 fine will be deducted</b> from your FLU Wallet (2nd+ cancellation this month) and added to Platform Compensation Fund.`;
  } else {
    fineNote.innerHTML = `This is your first cancellation this month — no fine this time.`;
  }
  document.getElementById('cancel-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeCancelModal() {
  document.getElementById('cancel-modal').classList.remove('open');
  document.body.style.overflow = '';
  cancelRideId = null;
}

async function confirmCancel() {
  if (!cancelRideId) return;
  const token = localStorage.getItem('flu_token');

  const btn = document.querySelector('#cancel-modal .btn-red');
  btn.textContent = 'Cancelling…';
  btn.disabled    = true;

  try {
    const res  = await fetch(`/api/rides/cancel/${cancelRideId}`, {
      method: 'PUT',
      headers: { Authorization: `Bearer ${token}` }
    });
    const data = await res.json();

    if (res.ok) {
      closeCancelModal();
      // Update local state
      const ride = publishedRides.find(r => r._id === cancelRideId);
      if (ride) ride.rideStatus = 'cancelled';
      cancellationsThisMonth++;
      updateStats();
      renderTab('published');

      if (data.fineApplied) {
        alert(`Ride cancelled. ₹100 fine applied. New wallet balance: ₹${data.newWalletBalance}`);
      }
    } else {
      alert(data.message || 'Cancel failed. Try again.');
    }
  } catch(e) {
    alert('Something went wrong.');
  } finally {
    btn.textContent = 'Yes, Cancel';
    btn.disabled    = false;
  }
}

document.getElementById('cancel-modal').addEventListener('click', e => {
  if (e.target.id === 'cancel-modal') closeCancelModal();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeCancelModal(); });

// ── SESSION ──
function getUser() {
  const u = localStorage.getItem('flu_user');
  return u ? JSON.parse(u) : null;
}
function logout() {
  localStorage.removeItem('flu_token');
  localStorage.removeItem('flu_user');
  location.href = '/';
}
function renderNav(user) {
  document.getElementById('nav-av').textContent    = user.name.charAt(0).toUpperCase();
  document.getElementById('nav-uname').textContent = user.name.split(' ')[0];
}
</script>

