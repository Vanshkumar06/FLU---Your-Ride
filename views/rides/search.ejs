<%- include('../partials/header') %>

<style>
@import url('https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@300,400,500,700&display=swap');

:root {
  --lime:    #C8F135;
  --mint:    #95CFB0;
  --black:   #080808;
  --white:   #ffffff;
  --card:    #101010;
  --border:  #1e1e1e;
  --grey:    #888;
  --dark:    #1c1c1c;
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--black);
  color: var(--white);
  font-family: 'Satoshi', sans-serif;
  overflow-x: hidden;
  min-height: 100vh;
}
a { text-decoration: none; color: inherit; }
button { font-family: 'Satoshi', sans-serif; cursor: pointer; }

body::after {
  content: '';
  position: fixed; inset: 0; pointer-events: none; z-index: 9999;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
  opacity: 0.03;
}

.nav {
  position: fixed; top: 1.5rem; left: 50%;
  transform: translateX(-50%);
  z-index: 1000;
  width: calc(100% - 4rem); max-width: 1100px;
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(8,8,8,0.75);
  backdrop-filter: blur(24px);
  border: 1px solid var(--border);
  border-radius: 100px;
  padding: 0.65rem 0.65rem 0.65rem 1.8rem;
  transition: transform 0.4s ease;
}
.nav.hidden { transform: translateX(-50%) translateY(-140%); }
.nav-logo { font-family: 'Clash Display', sans-serif; font-size: 1.25rem; font-weight: 700; letter-spacing: 4px; color: var(--lime); }
.nav-links { display: flex; gap: 0.2rem; position: absolute; left: 50%; transform: translateX(-50%); }
.nav-links a { font-size: 0.8rem; color: var(--grey); padding: 0.45rem 1rem; border-radius: 100px; transition: color 0.2s, background 0.2s; }
.nav-links a:hover { color: var(--white); background: var(--dark); }
.nav-links a.active { color: var(--black); background: var(--lime); }
.nav-actions { display: flex; gap: 0.5rem; align-items: center; }
.btn-ghost-nav { background: transparent; border: none; color: var(--grey); font-size: 0.8rem; padding: 0.45rem 0.9rem; border-radius: 100px; transition: color 0.2s; }
.btn-ghost-nav:hover { color: var(--white); }
.nav-chip { display: none; align-items: center; gap: 0.5rem; background: var(--dark); border-radius: 100px; padding: 0.3rem 0.9rem 0.3rem 0.4rem; }
.nav-av { width: 24px; height: 24px; border-radius: 50%; background: var(--lime); color: var(--black); font-size: 0.68rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.nav-uname { font-size: 0.78rem; color: var(--white); font-weight: 500; }

.hero {
  min-height: 40vh;
  display: flex; flex-direction: column;
  justify-content: flex-end;
  padding: 2rem 4rem 3rem;
  position: relative; overflow: hidden;
  border-bottom: 1px solid var(--border);
}
.hero-bg-glow { position: absolute; top: -20%; right: -5%; width: 700px; height: 500px; background: radial-gradient(ellipse, rgba(149,207,176,0.07) 0%, transparent 65%); pointer-events: none; }
.hero-bg-glow2 { position: absolute; bottom: -30%; left: 10%; width: 500px; height: 400px; background: radial-gradient(ellipse, rgba(200,241,53,0.04) 0%, transparent 65%); pointer-events: none; }
.hero-lines { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.hero-lines span { position: absolute; height: 1px; background: linear-gradient(90deg, transparent, rgba(149,207,176,0.12), transparent); animation: hline 4s linear infinite; opacity: 0; }
.hero-lines span:nth-child(1) { top: 30%; width: 35%; animation-delay: 0s; }
.hero-lines span:nth-child(2) { top: 55%; width: 55%; animation-delay: 1.2s; }
.hero-lines span:nth-child(3) { top: 70%; width: 25%; animation-delay: 2.4s; }
@keyframes hline { 0% { left: -60%; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 0.5; } 100% { left: 110%; opacity: 0; } }

.back-pill-wrap { padding: 6.5rem 4rem 0; position: relative; z-index: 2; }
.back-pill { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.04); border: 1px solid var(--border); color: var(--grey); font-size: 0.78rem; padding: 0.4rem 1rem; border-radius: 100px; width: fit-content; transition: color 0.2s, border-color 0.2s; opacity: 0; transform: translateY(10px); animation: fadeUp 0.6s ease 0.2s forwards; }
.back-pill:hover { color: var(--white); border-color: #444; }

.hero-h1 { font-family: 'Clash Display', sans-serif; font-size: clamp(3.5rem, 9vw, 8rem); font-weight: 700; line-height: 0.88; letter-spacing: -0.5px; }
.hero-h1 .word { display: inline-block; overflow: hidden; margin-right: 0.12em; }
.hero-h1 .word span { display: inline-block; transform: translateY(110%); transition: transform 0.8s cubic-bezier(0.16,1,0.3,1); }
.hero-h1 .lime { color: var(--lime); }
.hero-h1 .mint { color: var(--mint); }
.hero-sub { color: var(--grey); font-size: 0.95rem; line-height: 1.8; max-width: 480px; margin-top: 1.8rem; opacity: 0; transform: translateY(12px); animation: fadeUp 0.6s ease 1.1s forwards; }

.hero-search { margin-top: 2.5rem; display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.75rem; align-items: end; opacity: 0; transform: translateY(12px); animation: fadeUp 0.6s ease 1.3s forwards; }
.sf { display: flex; flex-direction: column; gap: 0.4rem; }
.sf-label { font-size: 0.65rem; color: var(--grey); letter-spacing: 2.5px; text-transform: uppercase; font-weight: 500; }
.sf-input { background: rgb(48, 47, 47); border: 1px solid var(--border); color: var(--white); padding: 0.9rem 1.1rem; border-radius: 14px; font-size: 0.9rem; font-family: 'Satoshi', sans-serif; outline: none; transition: border-color 0.3s, background 0.3s; color-scheme: dark; }
.sf-input::placeholder { color: white; }
.sf-input:focus { border-color: var(--mint); background: #141414; }
.sf-btn { background: var(--lime); color: var(--black); border: none; height: 48px; padding: 0 2rem; border-radius: 14px; font-size: 0.88rem; font-weight: 700; font-family: 'Clash Display', sans-serif; letter-spacing: 1px; white-space: nowrap; transition: opacity 0.2s, transform 0.2s; -webkit-text-fill-color: var(--black); }
.sf-btn:hover { opacity: 0.88; transform: translateY(-2px); }

/* Autocomplete dropdown */
.sf-wrap { position: relative; }
.autocomplete-list { position: absolute; top: 100%; left: 0; right: 0; background: #151515; border: 1px solid var(--border); border-top: none; border-radius: 0 0 12px 12px; z-index: 100; max-height: 200px; overflow-y: auto; display: none; }
.autocomplete-list.open { display: block; }
.ac-item { padding: 0.65rem 1rem; font-size: 0.85rem; color: var(--grey); cursor: pointer; transition: background 0.15s, color 0.15s; }
.ac-item:hover { background: #1d1d1d; color: var(--white); }

@keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

.layout { display: grid; grid-template-columns: 260px 1fr; min-height: calc(100vh - 52vh); }

.sidebar { border-right: 1px solid var(--border); padding: 2.5rem 1.5rem; position: sticky; top: 0; height: fit-content; }
.sidebar-title { font-size: 0.65rem; letter-spacing: 3px; text-transform: uppercase; color: var(--grey); font-weight: 600; margin-bottom: 2rem; display: flex; align-items: center; gap: 0.6rem; }
.sidebar-title::before { content:''; width:16px; height:1px; background:var(--mint); }
.fgroup { margin-bottom: 1.8rem; }
.fgroup-label { font-size: 0.65rem; letter-spacing: 2px; text-transform: uppercase; color: #444; font-weight: 600; margin-bottom: 0.75rem; display: block; }
.fopts { display: flex; flex-direction: column; gap: 0.4rem; }
.fchip { display: flex; align-items: center; gap: 0.55rem; padding: 0.5rem 0.85rem; border-radius: 10px; border: 1px solid var(--border); color: var(--grey); font-size: 0.8rem; background: transparent; transition: all 0.2s; text-align: left; }
.fchip:hover { border-color: #2a2a2a; color: var(--white); }
.fchip.on { border-color: var(--mint); color: var(--mint); background: rgba(149,207,176,0.06); }
.fchip .dot { width:6px; height:6px; border-radius:50%; background:currentColor; flex-shrink:0; }
.price-wrap { display: flex; flex-direction: column; gap: 0.6rem; }
.price-slider { -webkit-appearance: none; width: 100%; height: 2px; background: var(--border); border-radius: 2px; outline: none; }
.price-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 15px; height: 15px; border-radius: 50%; background: var(--mint); cursor: pointer; box-shadow: 0 0 0 3px rgba(149,207,176,0.18); }
.price-labels { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--grey); }
.price-labels em { color: var(--lime); font-style: normal; font-weight: 600; }
.reset-btn { width: 100%; background: transparent; border: 1px solid #1a1a1a; color: #333; padding: 0.55rem; border-radius: 10px; font-size: 0.75rem; font-family: 'Satoshi', sans-serif; transition: all 0.2s; margin-top: 0.5rem; }
.reset-btn:hover { border-color: var(--border); color: var(--grey); }

.results { padding: 2.5rem 2rem; }
.results-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
.results-label { font-family: 'Clash Display', sans-serif; font-size: 1.4rem; font-weight: 700; letter-spacing: -0.3px; }
.results-label span { color: var(--lime); }
.sort-wrap { display: flex; align-items: center; gap: 0.5rem; }
.sort-label { font-size: 0.75rem; color: var(--grey); }
.sort-sel { background: var(--card); border: 1px solid var(--border); color: var(--white); padding: 0.45rem 0.9rem; border-radius: 10px; font-size: 0.78rem; font-family: 'Satoshi', sans-serif; outline: none; }
.sort-sel option { background: #111; }

.ride-list { display: flex; flex-direction: column; gap: 1rem; }

.ride-card { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 1.6rem; display: grid; grid-template-columns: 1fr auto; gap: 1.2rem; align-items: center; position: relative; overflow: hidden; opacity: 0; transform: translateX(-28px); transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.16,1,0.3,1), border-color 0.3s, box-shadow 0.3s; }
.ride-card.visible { opacity: 1; transform: translateX(0); }
.ride-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: transparent; transition: background 0.3s; }
.ride-card:hover { border-color: rgba(149,207,176,0.3); box-shadow: 0 8px 40px rgba(0,0,0,0.4); }
.ride-card:hover::before { background: linear-gradient(90deg, transparent, var(--mint), transparent); }
.ride-card.featured { border-color: rgba(200,241,53,0.15); }
.ride-card.featured::before { background: linear-gradient(90deg, transparent, var(--lime), transparent); }

.cl { display: flex; flex-direction: column; gap: 0.9rem; }
.route { display: flex; align-items: center; gap: 0.75rem; }
.city { font-family: 'Clash Display', sans-serif; font-size: 1.35rem; font-weight: 700; letter-spacing: -0.3px; }
.route-mid { flex: 1; display: flex; align-items: center; gap: 0.4rem; max-width: 100px; }
.rline { flex: 1; height: 1px; background: linear-gradient(90deg, var(--border), rgba(149,207,176,0.4), var(--border)); }
.rarrow { color: var(--mint); font-size: 0.9rem; flex-shrink: 0; }
.rduration { font-size: 0.68rem; color: var(--grey); background: var(--dark); padding: 0.2rem 0.6rem; border-radius: 100px; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; }
.cmeta { display: flex; flex-wrap: wrap; gap: 1.2rem; }
.cmi { display: flex; align-items: center; gap: 0.35rem; font-size: 0.78rem; color: var(--grey); }
.cmi.hi { color: var(--mint); }
.cmi.lime { color: var(--lime); }
.driver-row { display: flex; align-items: center; gap: 0.6rem; }
.dav { width: 30px; height: 30px; border-radius: 50%; background: var(--mint); color: var(--black); font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.dinfo { display: flex; flex-direction: column; }
.dname { font-size: 0.82rem; font-weight: 600; color: var(--white); }
.drating { font-size: 0.7rem; color: var(--grey); }
.drating b { color: var(--lime); }
.vbadge { margin-left: auto; font-size: 0.65rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--mint); background: rgba(149,207,176,0.08); border: 1px solid rgba(149,207,176,0.2); padding: 0.18rem 0.55rem; border-radius: 100px; }
.ctags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
.ctag { font-size: 0.65rem; letter-spacing: 1px; text-transform: uppercase; padding: 0.18rem 0.55rem; border-radius: 6px; border: 1px solid var(--border); color: var(--grey); background: rgba(255,255,255,0.02); }
.ctag.l { color: var(--lime); border-color: rgba(200,241,53,0.2); background: rgba(200,241,53,0.05); }
.ctag.m { color: var(--mint); border-color: rgba(149,207,176,0.2); background: rgba(149,207,176,0.05); }

.cr { display: flex; flex-direction: column; align-items: flex-end; gap: 0.8rem; min-width: 120px; }
.price-big { font-family: 'Clash Display', sans-serif; font-size: 2.2rem; font-weight: 700; color: var(--lime); letter-spacing: -1.5px; line-height: 1; text-align: right; }
.price-per { font-size: 0.7rem; color: var(--grey); text-align: right; margin-top: 0.1rem; }
.seats-pill { display: flex; align-items: center; gap: 0.4rem; font-size: 0.7rem; color: var(--grey); }
.sdot { width: 6px; height: 6px; border-radius: 50%; background: var(--mint); animation: blink 1.8s ease infinite; }
@keyframes blink { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:0.4; transform:scale(1.4); } }
.book-btn { background: var(--lime); color: var(--black); border: none; padding: 0.7rem 1.4rem; border-radius: 100px; font-size: 0.8rem; font-weight: 700; font-family: 'Clash Display', sans-serif; letter-spacing: 0.5px; white-space: nowrap; transition: opacity 0.2s, transform 0.2s; -webkit-text-fill-color: var(--black); }
.book-btn:hover { opacity: 0.9; transform: scale(0.97); }
.book-btn:disabled { background: var(--dark); color: var(--grey); cursor: not-allowed; transform: none; opacity: 1; -webkit-text-fill-color: var(--grey); }

.skel-card { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 1.6rem; display: flex; flex-direction: column; gap: 0.9rem; }
.sk { background: linear-gradient(90deg, #151515 25%, #1d1d1d 50%, #151515 75%); background-size: 300% 100%; animation: shimmer 1.6s infinite; border-radius: 6px; }
@keyframes shimmer { 0%{background-position:300% 0} 100%{background-position:-300% 0} }
.sk-h { height: 32px; width: 55%; }
.sk-m { height: 13px; width: 75%; }
.sk-s { height: 11px; width: 38%; }

.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 7rem 2rem; text-align: center; opacity: 0; animation: fadeUp 0.5s ease 0.3s forwards; }
.empty-ico { font-size: 3.5rem; margin-bottom: 1.5rem; opacity: 0.35; }
.empty-h { font-family: 'Clash Display', sans-serif; font-size: 2rem; font-weight: 700; margin-bottom: 0.75rem; }
.empty-p { color: var(--grey); font-size: 0.88rem; line-height: 1.75; max-width: 300px; }
.empty-action { margin-top: 2rem; background: var(--lime); border: none; color: var(--black) !important; -webkit-text-fill-color: var(--black) !important; padding: 0.82rem 2.2rem; border-radius: 100px; font-size: 0.85rem; font-weight: 700; font-family: 'Clash Display', sans-serif; letter-spacing: 0.5px; transition: opacity 0.2s, transform 0.2s; }
.empty-action:hover { opacity: 0.88; transform: scale(0.98); }

.backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92); backdrop-filter: blur(18px); z-index: 5000; align-items: center; justify-content: center; }
.backdrop.open { display: flex; }
.mpanel { background: var(--card); border: 1px solid var(--border); border-radius: 26px; padding: 2.5rem; width: 100%; max-width: 430px; margin: 1rem; position: relative; animation: panelIn 0.38s cubic-bezier(0.16,1,0.3,1); }
@keyframes panelIn { from { opacity:0; transform:translateY(28px) scale(0.96); } to { opacity:1; transform:none; } }
.mpanel::before { content: ''; position: absolute; top:0; left:0; right:0; height:1px; background: linear-gradient(90deg, transparent, var(--mint), transparent); border-radius: 26px 26px 0 0; }
.mclose { position: absolute; top:1.2rem; right:1.2rem; width:28px; height:28px; border-radius:50%; background:#1a1a1a; border:1px solid var(--border); color:var(--grey); font-size:0.75rem; display:flex; align-items:center; justify-content:center; transition: color 0.2s; }
.mclose:hover { color: var(--white); }
.mroute { display: flex; align-items: center; gap: 0.7rem; padding-bottom: 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
.mcity { font-family: 'Clash Display', sans-serif; font-size: 1.5rem; font-weight: 700; }
.marrow { color: var(--mint); font-size: 1.2rem; }
.mmeta { display: flex; flex-direction: column; gap: 0.55rem; margin-bottom: 1.5rem; }
.mrow { display: flex; justify-content: space-between; align-items: center; }
.mk { font-size: 0.78rem; color: var(--grey); }
.mv { font-size: 0.84rem; color: var(--white); font-weight: 500; }
.mv.lime { color: var(--lime); font-family: 'Clash Display', sans-serif; font-size: 1.1rem; }
.mv.mint { color: var(--mint); }
.mdiv { border: none; border-top: 1px solid var(--border); margin: 0.75rem 0; }
.seat-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
.seat-row-label { font-size: 0.78rem; color: var(--grey); flex: 1; }
.seat-controls { display: flex; align-items: center; gap: 0.75rem; }
.scbtn { width: 30px; height: 30px; border-radius: 50%; background: var(--dark); border: 1px solid var(--border); color: var(--white); font-size: 1rem; display: flex; align-items: center; justify-content: center; transition: border-color 0.2s, color 0.2s; }
.scbtn:hover { border-color: var(--mint); color: var(--mint); }
.scnum { font-family: 'Clash Display', sans-serif; font-size: 1.4rem; font-weight: 700; color: var(--mint); min-width: 22px; text-align: center; }
.mtotal { background: rgba(149,207,176,0.05); border: 1px solid rgba(149,207,176,0.15); border-radius: 14px; padding: 1rem 1.2rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
.mtotal-label { font-size: 0.8rem; color: var(--grey); }
.mtotal-amt { font-family: 'Clash Display', sans-serif; font-size: 2rem; font-weight: 700; color: var(--lime); letter-spacing: -1px; }
.merr { background: rgba(255,60,50,0.07); border: 1px solid rgba(255,60,50,0.18); color: #ff5040; font-size: 0.78rem; padding: 0.55rem 0.9rem; border-radius: 10px; margin-bottom: 1rem; display: none; }
.mconfirm { width: 100%; background: var(--lime); color: var(--black); border: none; padding: 1rem; border-radius: 12px; font-size: 0.9rem; font-weight: 700; font-family: 'Clash Display', sans-serif; letter-spacing: 1px; transition: opacity 0.2s; -webkit-text-fill-color: var(--black); }
.mconfirm:hover { opacity: 0.88; }
.mnote { text-align: center; font-size: 0.7rem; color: #2a2a2a; margin-top: 0.75rem; }

.modal-title { font-family: 'Clash Display', sans-serif; font-size: 1.9rem; font-weight: 700; margin-bottom: 0.3rem; }
.modal-sub { color: var(--grey); font-size: 0.8rem; margin-bottom: 1.8rem; }
.mg { margin-bottom: 0.9rem; }
.ml { font-size: 0.65rem; color: var(--grey); letter-spacing: 2px; text-transform: uppercase; display: block; margin-bottom: 5px; }
.mi { width: 100%; background: rgba(255,255,255,0.03); border: 1px solid var(--border); color: var(--white); padding: 0.82rem 1rem; border-radius: 10px; font-size: 0.86rem; font-family: 'Satoshi', sans-serif; outline: none; transition: border-color 0.25s; }
.mi::placeholder { color: #2a2a2a; }
.mi:focus { border-color: var(--mint); }
.msub { width: 100%; background: var(--lime); color: var(--black); border: none; padding: 0.9rem; border-radius: 10px; font-size: 0.9rem; font-weight: 700; font-family: 'Clash Display', sans-serif; letter-spacing: 1px; margin-top: 0.4rem; margin-bottom: 1rem; transition: opacity 0.2s; -webkit-text-fill-color: var(--black); }
.msub:hover { opacity: 0.88; }
.mdivider { display: flex; align-items: center; gap: 0.75rem; color: #333; font-size: 0.72rem; margin: 0.8rem 0; }
.mdivider::before,.mdivider::after { content:''; flex:1; height:1px; background:var(--border); }
.mgoogle { width: 100%; background: transparent; border: 1px solid var(--border); color: var(--grey); padding: 0.82rem; border-radius: 10px; font-size: 0.82rem; font-family: 'Satoshi', sans-serif; display: flex; align-items: center; justify-content: center; gap: 0.55rem; transition: border-color 0.2s, color 0.2s; }
.mgoogle:hover { border-color: #2a2a2a; color: var(--white); }
.mswitch { text-align:center; color:#555; font-size:0.8rem; margin-top:1rem; }
.mswitch a { color: var(--mint); cursor: pointer; }

@media (max-width: 960px) {
  .nav { width: calc(100% - 2rem); }
  .nav-links { display: none; }
  .hero { padding: 0 2rem 2.5rem; }
  .hero-search { grid-template-columns: 1fr 1fr; }
  .hero-search .sf-btn { grid-column: 1/-1; }
  .layout { grid-template-columns: 1fr; }
  .sidebar { display: none; }
  .results { padding: 1.5rem; }
  .ride-card { grid-template-columns: 1fr; }
  .cr { flex-direction: row; align-items: center; justify-content: space-between; min-width: unset; }
}
@media (max-width: 560px) {
  .hero-search { grid-template-columns: 1fr; }
