<script>
// ── STATE ──
let allRides = [], filteredRides = [], activeRide = null, seatCount = 1;
let F = { time:'all', seats:'any', price:2000, ac:false, ladies:false };
let distanceDB = null;
let cities = [];

// ── INIT ──
document.addEventListener('DOMContentLoaded', async () => {
  const user = getUser();
  if (user) renderNav(user);

  const today = new Date().toISOString().split('T')[0];
  document.getElementById('date-inp').min   = today;
  document.getElementById('date-inp').value = today;

  // Read URL params
  const p    = new URLSearchParams(window.location.search);
  const from = p.get('from') || '';
  const to   = p.get('to')   || '';
  const date = p.get('date') || today;

  if (from) document.getElementById('from-inp').value = from;
  if (to)   document.getElementById('to-inp').value   = to;
  document.getElementById('date-inp').value = date;

  if (from && to) {
    document.getElementById('route-tag').textContent = ` · ${from} → ${to}`;
  }

  // Load distance DB + cities
  try {
    const [dr, cr] = await Promise.all([
      fetch('/data/distances.json'),
      fetch('/data/cities.json')
    ]);
    distanceDB = await dr.json();
    const cdb  = await cr.json();
    cities = cdb.allCities || [];
  } catch(e) {
    cities = [
      'Ambala','Bhiwani','Charkhi Dadri','Faridabad','Fatehabad','Gurugram','Hisar',
      'Jhajjar','Jind','Kaithal','Karnal','Kurukshetra','Mahendragarh','Nuh','Palwal',
      'Panchkula','Panipat','Rewari','Rohtak','Sirsa','Sonipat','Yamunanagar',
      'Amritsar','Barnala','Bathinda','Faridkot','Fatehgarh Sahib','Fazilka','Ferozepur',
      'Gurdaspur','Hoshiarpur','Jalandhar','Kapurthala','Khanna','Ludhiana','Malerkotla',
      'Mansa','Moga','Muktsar','Pathankot','Patiala','Rupnagar','Mohali','Sangrur',
      'Nawanshahr','Tarn Taran'
    ];
  }

  // If from+to in URL → search immediately
  // Otherwise show empty state (not loading)
  if (from && to) {
    loadRides(from, to, date);
  } else {
    show('empty');
    document.querySelector('#state-empty .empty-ico').textContent  = '🔍';
    document.querySelector('#state-empty .empty-h').textContent    = 'Search for a ride';
    document.querySelector('#state-empty .empty-p').textContent    = 'Enter your From and To cities above to find available rides.';
    document.querySelector('#state-empty .empty-action').style.display = 'none';
  }
});

// ── AUTOCOMPLETE ──
function acFilter(inputId, listId) {
  const val  = document.getElementById(inputId).value.trim().toLowerCase();
  const list = document.getElementById(listId);
  if (!val || val.length < 1) { list.classList.remove('open'); return; }
  const matches = cities.filter(c => c.toLowerCase().startsWith(val)).slice(0, 8);
  if (!matches.length) { list.classList.remove('open'); return; }
  list.innerHTML = matches.map(c =>
    `<div class="ac-item" onmousedown="pickCity('${inputId}','${listId}','${c}')">${c}</div>`
  ).join('');
  list.classList.add('open');
}
function pickCity(inputId, listId, city) {
  document.getElementById(inputId).value = city;
  closeAc(listId);
}
function closeAc(listId) {
  document.getElementById(listId).classList.remove('open');
}

// ── NAVBAR ──
let lastY = 0;
window.addEventListener('scroll', () => {
  const y = window.scrollY;
  document.getElementById('nav').classList.toggle('hidden', y > lastY && y > 100);
  lastY = y;
});
window.addEventListener('load', () => {
  document.querySelectorAll('.hero-h1 .word span').forEach((s, i) => {
    setTimeout(() => {
      s.style.transition = 'transform 0.85s cubic-bezier(0.16,1,0.3,1)';
      s.style.transform  = 'translateY(0)';
    }, 300 + i * 110);
  });
});

// ── FETCH RIDES ──
// FIX 1: correct API endpoint /api/rides/search
async function loadRides(from, to, date) {
  show('loading');
  try {
    let url = `/api/rides/search?`;
    if (from) url += `from=${encodeURIComponent(from)}&`;
    if (to)   url += `to=${encodeURIComponent(to)}&`;
    if (date) url += `date=${encodeURIComponent(date)}`;

    const token = localStorage.getItem('flu_token');
    const res   = await fetch(url, { headers: token ? { Authorization: `Bearer ${token}` } : {} });
    const data  = await res.json();
    // Handle both array response and {rides:[]} response
    allRides = Array.isArray(data) ? data : (data.rides || []);
    filteredRides = [...allRides];
    render();
  } catch(e) {
    console.error('Search error:', e);
    allRides = []; filteredRides = [];
    render();
  }
}

// ── RENDER ──
function render() {
  if (!filteredRides.length) { show('empty'); return; }
  show('results');
  document.getElementById('count-num').textContent = filteredRides.length;
  const list = document.getElementById('ride-list');
  list.innerHTML = '';
  filteredRides.forEach((ride, i) => {
    const card = buildCard(ride);
    list.appendChild(card);
    setTimeout(() => card.classList.add('visible'), 60 + i * 80);
  });
}

function show(state) {
  ['loading','results','empty'].forEach(s =>
    document.getElementById(`state-${s}`).style.display = s === state ? 'block' : 'none'
  );
}

// ── BUILD CARD ──
// FIX 2: use fromLocation/toLocation/seatsAvailable — DB field names
function buildCard(ride) {
  const card = document.createElement('div');
  card.className = 'ride-card';

  // FIX: DB saves as fromLocation/toLocation/seatsAvailable
  const fc    = ride.fromLocation || ride.from || '—';
  const tc    = ride.toLocation   || ride.to   || '—';
  const seats = ride.seatsAvailable ?? ride.seats ?? 0;
  const price = ride.pricePerSeat  || ride.price  || 0;
  const dt    = ride.departureTime || ride.time   || '—';
  const dd    = ride.date
    ? new Date(ride.date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' })
    : '—';

  // Driver info — populated via .populate('driverId')
  const driver = ride.driverId || ride.driver || {};
  const dn     = driver.name   || 'Driver';
  const di     = dn.charAt(0).toUpperCase();

  // Distance & cashback
  const km       = ride.distanceKm || getDistance(fc, tc);
  const etaStr   = km ? getETA(km) : (ride.duration || '—');
  const cashback = km ? getCashback(km) : null;
  const distTag  = km ? km + ' km' : null;

  const ac     = ride.amenities?.ac     || false;
  const ladies = ride.amenities?.ladies || false;

  // Safely serialize for onclick
  const rj = JSON.stringify({
    _id: ride._id,
    fromLocation: fc,
    toLocation:   tc,
    departureTime: dt,
    date:          ride.date,
    pricePerSeat:  price,
    seatsAvailable: seats,
    distanceKm:    km,
    driverId:      { name: dn }
  }).replace(/'/g, '&#39;');

  card.innerHTML = `
    <div class="cl">
      <div class="route">
        <span class="city">${fc}</span>
        <div class="route-mid">
          <div class="rline"></div>
          <span class="rarrow">→</span>
          <div class="rline"></div>
        </div>
        <span class="city">${tc}</span>
        <span class="rduration">${etaStr}${distTag ? ' · ' + distTag : ''}</span>
      </div>
      <div class="cmeta">
        <div class="cmi">🕐 ${dt}</div>
        <div class="cmi">📅 ${dd}</div>
        ${distTag ? `<div class="cmi hi">📍 ${distTag}</div>` : ''}
        ${cashback ? `<div class="cmi lime">💰 ₹${cashback} cashback for you</div>` : ''}
      </div>
      <div class="driver-row">
        <div class="dav">${di}</div>
        <div class="dinfo">
          <span class="dname">${dn}</span>
          <span class="drating">★ <b>New</b> · FLU Driver</span>
        </div>
        <span class="vbadge">✓ Verified</span>
      </div>
      <div class="ctags">
        ${ac     ? '<span class="ctag l">AC</span>' : ''}
        ${ladies ? '<span class="ctag m">Ladies Only</span>' : ''}
        ${seats <= 2 ? '<span class="ctag m">Almost Full</span>' : ''}
        <span class="ctag">Instant Confirm</span>
      </div>
    </div>
    <div class="cr">
      <div>
        <div class="price-big">₹${price}</div>
        <div class="price-per">per seat</div>
      </div>
      <div class="seats-pill">
        <span class="sdot"></span>${seats} seat${seats !== 1 ? 's' : ''} left
      </div>
      <button class="book-btn" ${seats === 0 ? 'disabled' : ''} onclick='openBook(JSON.parse(this.dataset.ride))' data-ride='${rj}'>
        ${seats === 0 ? 'Full' : 'Book Seat'}
      </button>
    </div>
  `;
  return card;
}

// ── DISTANCE HELPERS ──
function getDistance(from, to) {
  if (!distanceDB || !from || !to) return null;
  return distanceDB.distances?.[from]?.[to] ?? null;
}
function getETA(km) {
  if (!km) return null;
  const h = km / 60;
  if (h < 1) return '~' + Math.round(h * 60) + 'm';
  const hh = Math.floor(h), mm = Math.round((h - hh) * 60);
  return mm > 0 ? '~' + hh + 'h ' + mm + 'm' : '~' + hh + 'h';
}
function getCashback(km) { return km ? (km * 0.5).toFixed(0) : null; }

// ── SEARCH ──
function doSearch() {
  const from = document.getElementById('from-inp').value.trim();
  const to   = document.getElementById('to-inp').value.trim();
  const date = document.getElementById('date-inp').value;
  if (!from || !to) { alert('Please enter both From and To cities'); return; }
  // Update URL and fetch
  history.pushState({}, '', `/rides/search?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}&date=${date}`);
  document.getElementById('route-tag').textContent = ` · ${from} → ${to}`;
  loadRides(from, to, date);
}
document.addEventListener('keydown', e => {
  if (e.key === 'Enter' && ['from-inp','to-inp','date-inp'].includes(e.target.id)) doSearch();
});

// ── SORT ──
function sortRides(v) {
  if (v === 'price') filteredRides.sort((a,b) => (a.pricePerSeat||0) - (b.pricePerSeat||0));
  if (v === 'time')  filteredRides.sort((a,b) => (a.departureTime||'').localeCompare(b.departureTime||''));
  if (v === 'seats') filteredRides.sort((a,b) => (b.seatsAvailable||0) - (a.seatsAvailable||0));
  render();
}

// ── FILTERS ──
function setFilter(btn, key, val) {
  btn.closest('.fopts').querySelectorAll('.fchip').forEach(c => c.classList.remove('on'));
  btn.classList.add('on');
  F[key] = val;
  applyFilters();
}
function updatePrice(v) {
  F.price = +v;
  document.getElementById('p-val').textContent = '₹' + v;
  applyFilters();
}
function applyFilters() {
  filteredRides = allRides.filter(r => {
    if ((r.pricePerSeat||0) > F.price) return false;
    if (F.seats !== 'any' && (r.seatsAvailable||0) < +F.seats) return false;
    if (F.time === 'morning'   && (r.departureTime||'') >= '12:00') return false;
    if (F.time === 'afternoon' && ((r.departureTime||'') < '12:00' || (r.departureTime||'') >= '18:00')) return false;
    if (F.time === 'evening'   && (r.departureTime||'') < '18:00') return false;
    if (F.ac     && !r.amenities?.ac)     return false;
    if (F.ladies && !r.amenities?.ladies) return false;
    return true;
  });
  render();
}
function resetFilters() {
  F = { time:'all', seats:'any', price:2000, ac:false, ladies:false };
  document.getElementById('p-range').value = 2000;
  document.getElementById('p-val').textContent = '₹2000';
  document.querySelectorAll('.fchip').forEach(c => c.classList.remove('on'));
  document.querySelectorAll('.fopts').forEach(g => g.firstElementChild?.classList.add('on'));
  filteredRides = [...allRides];
  render();
}

// ── BOOKING MODAL ──
function openBook(ride) {
  if (!getUser()) { openAuth('login'); return; }
  activeRide = ride; seatCount = 1;

  const fc = ride.fromLocation || ride.from || '—';
  const tc = ride.toLocation   || ride.to   || '—';

  document.getElementById('bm-from').textContent   = fc;
  document.getElementById('bm-to').textContent     = tc;
  document.getElementById('bm-driver').textContent = ride.driverId?.name || ride.driver?.name || '—';
  document.getElementById('bm-time').textContent   = ride.departureTime || '—';
  document.getElementById('bm-date').textContent   = ride.date
    ? new Date(ride.date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' })
    : '—';
  document.getElementById('bm-price').textContent  = '₹' + (ride.pricePerSeat || 0);

  const km = ride.distanceKm || getDistance(fc, tc);
  document.getElementById('bm-distance').textContent = km ? km + ' km' : '—';
  document.getElementById('bm-cashback').textContent  = km ? '₹' + getCashback(km) : '—';

  document.getElementById('sc').textContent = '1';
  calcTotal();
  document.getElementById('book-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeBook() {
  document.getElementById('book-modal').classList.remove('open');
  document.body.style.overflow = '';
}
function seat(d) {
  const max = activeRide?.seatsAvailable || 4;
  seatCount = Math.max(1, Math.min(max, seatCount + d));
  document.getElementById('sc').textContent = seatCount;
  calcTotal();
}
function calcTotal() {
  document.getElementById('bm-total').textContent = '₹' + (activeRide?.pricePerSeat || 0) * seatCount;
}
async function confirmBook() {
  const token = localStorage.getItem('flu_token');
  const errEl = document.getElementById('book-err');
  errEl.style.display = 'none';
  if (!token) { openAuth('login'); return; }
  const btn = document.querySelector('.mconfirm');
  btn.textContent = 'Booking…'; btn.disabled = true;
  try {
    const res  = await fetch('/api/bookings', {
      method:'POST',
      headers:{ 'Content-Type':'application/json', Authorization:`Bearer ${token}` },
      body: JSON.stringify({ rideId: activeRide._id, seats: seatCount })
    });
    const data = await res.json();
    if (res.ok) {
      closeBook();
      alert('✅ Booking confirmed! Razorpay payment coming soon.');
      location.href = '/history';
    } else {
      errEl.textContent = data.message || 'Booking failed.';
      errEl.style.display = 'block';
    }
  } catch {
    errEl.textContent = 'Something went wrong.';
    errEl.style.display = 'block';
  } finally {
    btn.textContent = 'Confirm & Pay with Razorpay →'; btn.disabled = false;
  }
}
document.getElementById('book-modal').addEventListener('click', e => { if(e.target.id==='book-modal') closeBook(); });

// ── AUTH ──
function openAuth(t) {
  ['login-modal','signup-modal'].forEach(id => document.getElementById(id).classList.remove('open'));
  document.getElementById(t+'-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeAuth() {
  ['login-modal','signup-modal'].forEach(id => document.getElementById(id).classList.remove('open'));
  document.body.style.overflow = '';
}
['login-modal','signup-modal'].forEach(id =>
  document.getElementById(id).addEventListener('click', e => { if(e.target.id===id) closeAuth(); })
);
document.addEventListener('keydown', e => { if(e.key==='Escape'){ closeAuth(); closeBook(); } });

async function doLogin(e) {
  e.preventDefault();
  const err = document.getElementById('login-err');
  err.style.display = 'none';
  try {
    const res  = await fetch('/api/auth/login', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ email:document.getElementById('l-email').value, password:document.getElementById('l-pass').value }) });
    const data = await res.json();
    if (res.ok) { saveUser(data.token,data.user); closeAuth(); renderNav(data.user); }
    else { err.textContent = data.message; err.style.display='block'; }
  } catch { err.textContent='Something went wrong.'; err.style.display='block'; }
}
async function doSignup(e) {
  e.preventDefault();
  const err = document.getElementById('signup-err');
  err.style.display = 'none';
  try {
    const res  = await fetch('/api/auth/register', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ name:document.getElementById('s-name').value, email:document.getElementById('s-email').value, password:document.getElementById('s-pass').value, phoneNumber:document.getElementById('s-phone').value }) });
    const data = await res.json();
    if (res.ok) { saveUser(data.token,data.user); closeAuth(); renderNav(data.user); }
    else { err.textContent=data.message; err.style.display='block'; }
  } catch { err.textContent='Something went wrong.'; err.style.display='block'; }
}

function saveUser(token,user){ localStorage.setItem('flu_token',token); localStorage.setItem('flu_user',JSON.stringify(user)); }
function getUser(){ const u=localStorage.getItem('flu_user'); return u?JSON.parse(u):null; }
function logout(){ localStorage.removeItem('flu_token'); localStorage.removeItem('flu_user'); location.href='/'; }
function renderNav(user){
  document.getElementById('nav-auth').style.display='none';
  const chip=document.getElementById('nav-chip');
  chip.style.display='flex';
  document.getElementById('nav-av').textContent=user.name.charAt(0).toUpperCase();
  document.getElementById('nav-uname').textContent=user.name.split(' ')[0];
}
</script>

