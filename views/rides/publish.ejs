  <!-- ══════════════════════════════════
     JAVASCRIPT
══════════════════════════════════ -->
  <script>
    // ── STATE ──
    let distanceDB = null;
    let currentKm = null;
    let amenities = { ac: false, music: false, luggage: false, ladies: false };
    let driverStatus = { ridesThisMonth: 0, subscription: null, cancellationsThisMonth: 0 };

    // ── NAVBAR HIDE/SHOW ──
    let lastY = 0;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      document.getElementById('nav').classList.toggle('hidden', y > lastY && y > 100);
      lastY = y;
    });

    // ── HERO ANIMATION ──
    window.addEventListener('load', () => {
      document.querySelectorAll('.hero-h1 .word span').forEach((s, i) => {
        setTimeout(() => {
          s.style.transition = 'transform .85s cubic-bezier(.16,1,.3,1)';
          s.style.transform = 'translateY(0)';
        }, 300 + i * 110);
      });
    });

    // ── INIT ──
    document.addEventListener('DOMContentLoaded', async () => {
      // Set today as min date
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('f-date').min = today;
      document.getElementById('f-date').value = today;

      // Load distance DB
      try {
        const r = await fetch('/data/distances.json');
        distanceDB = await r.json();
      } catch (e) { console.warn('distanceDB not loaded'); }

      // Load cities — with fallback
      const fallbackCities = [
        'Ambala', 'Bhiwani', 'Charkhi Dadri', 'Faridabad', 'Fatehabad', 'Gurugram', 'Hisar',
        'Jhajjar', 'Jind', 'Kaithal', 'Karnal', 'Kurukshetra', 'Mahendragarh', 'Nuh', 'Palwal',
        'Panchkula', 'Panipat', 'Rewari', 'Rohtak', 'Sirsa', 'Sonipat', 'Yamunanagar',
        'Amritsar', 'Barnala', 'Bathinda', 'Faridkot', 'Fatehgarh Sahib', 'Fazilka', 'Ferozepur',
        'Gurdaspur', 'Hoshiarpur', 'Jalandhar', 'Kapurthala', 'Khanna', 'Ludhiana', 'Malerkotla',
        'Mansa', 'Moga', 'Muktsar', 'Pathankot', 'Patiala', 'Rupnagar', 'Mohali', 'Sangrur',
        'Nawanshahr', 'Tarn Taran'
      ];
      try {
        const r2 = await fetch('/data/cities.json');
        const cdb = await r2.json();
        populateCities(cdb.allCities);
      } catch (e) { populateCities(fallbackCities); }

      // Check auth
      const user = getUser();
      if (user) showDashboard(user);
    });

    function populateCities(list) {
      const sorted = [...list].sort();
      ['f-from', 'f-to'].forEach(id => {
        const sel = document.getElementById(id);
        sorted.forEach(c => {
          const o = document.createElement('option');
          o.value = c; o.textContent = c;
          sel.appendChild(o);
        });
      });
    }

    // ── SHOW DASHBOARD AFTER LOGIN ──
    async function showDashboard(user) {
      // Hide auth gate, show layout
      document.getElementById('auth-gate').classList.remove('show');
      document.getElementById('form-col').style.display = 'flex';
      document.getElementById('preview-col').style.display = 'flex';
      document.getElementById('status-bar').style.display = 'block';

      // Set driver preview avatar
      document.getElementById('pc-av').textContent = user.name.charAt(0).toUpperCase();
      document.getElementById('pc-dname').textContent = user.name;
      renderNav(user);

      // Fetch driver status from backend
      try {
        const token = localStorage.getItem('flu_token');
        const res = await fetch('/api/driver/status', {
          headers: { Authorization: `Bearer ${token}` }
        });
        if (res.ok) driverStatus = await res.json();
      } catch (e) {
        // Fallback: treat as new user (0 rides, free tier)
        driverStatus = { ridesThisMonth: 0, subscription: null, cancellationsThisMonth: 0, subscriptionRidesLimit: 0 };
      }

      updateStatusBar();
      updatePreview();
    }

    // ── STATUS BAR UPDATE ──
    function updateStatusBar() {
      const s = driverStatus;
      const numEl = document.getElementById('sb-num');
      const fillEl = document.getElementById('sb-fill');
      const cntEl = document.getElementById('sb-track-count');
      const lblEl = document.getElementById('sb-track-lbl');
      const planEl = document.getElementById('sb-plan-name');
      const badgeEl = document.getElementById('sb-badge');

      if (!s.subscription) {
        // Free tier
        const used = Math.min(s.ridesThisMonth, 3);
        const pct = (used / 3) * 100;
        numEl.textContent = used + '/3';
        numEl.style.color = used >= 3 ? 'var(--red)' : used >= 2 ? 'var(--orange)' : 'var(--lime)';
        fillEl.style.width = pct + '%';
        fillEl.style.background = used >= 3 ? 'var(--red)' : used >= 2 ? 'var(--orange)' : 'var(--lime)';
        cntEl.textContent = used + ' / 3 free rides';
        lblEl.textContent = 'Free tier usage';
        planEl.textContent = 'Free Plan';
        badgeEl.textContent = used >= 3 ? 'LOCKED' : used >= 2 ? 'ALMOST FULL' : 'FREE';
        badgeEl.className = 'sb-badge ' + (used >= 3 ? 'badge-locked' : used >= 2 ? 'badge-warn' : 'badge-free');
      } else {
        const lim = s.subscription === 'unlimited' ? Infinity : s.subscriptionRidesLimit;
        const used = s.ridesThisMonth;
        const pct = lim === Infinity ? 25 : Math.min((used / lim) * 100, 100);
        numEl.textContent = lim === Infinity ? used + ' rides' : used + '/' + lim;
        numEl.style.color = 'var(--lime)';
        fillEl.style.width = pct + '%';
        fillEl.style.background = 'var(--lime)';
        cntEl.textContent = used + (lim === Infinity ? ' rides this month' : ' / ' + lim);
        lblEl.textContent = 'Monthly usage';
        planEl.textContent = s.subscription === 'basic' ? 'Basic · 5/mo'
          : s.subscription === 'standard' ? 'Standard · 15/mo' : 'Unlimited';
        badgeEl.textContent = 'SUBSCRIBED';
        badgeEl.className = 'sb-badge badge-sub';
      }

      // Fine warning
      if (s.cancellationsThisMonth >= 1) {
        document.getElementById('fine-strip').classList.add('show');
      }
    }

    // ── ROUTE CHANGE → auto-fill distance, ETA, cashback ──
    function onRouteChange() {
      const from = document.getElementById('f-from').value;
      const to = document.getElementById('f-to').value;
      const rrEl = document.getElementById('route-result');
      const cbEl = document.getElementById('cb-note');

      if (!from || !to || from === to) {
        rrEl.classList.remove('show');
        cbEl.classList.remove('show');
        currentKm = null;
        document.getElementById('price-sug').style.display = 'none';
        updatePreview(); return;
      }

      const km = distanceDB?.distances?.[from]?.[to] ?? null;
      currentKm = km;

      if (km) {
        document.getElementById('rr-from').textContent = from;
        document.getElementById('rr-to').textContent = to;
        document.getElementById('rr-km').textContent = km + ' km';
        document.getElementById('rr-eta').textContent = eta(km);
        rrEl.classList.add('show');

        // Passenger cashback (NOT driver)
        const cb = (km * 0.5).toFixed(0);
        document.getElementById('cb-amt').textContent = '₹' + cb;
        cbEl.classList.add('show');

        // Suggested price ₹2/km
        const sug = Math.round(km * 2 / 10) * 10;
        document.getElementById('price-sug-val').textContent = '₹' + sug;
        document.getElementById('price-sug').style.display = 'block';

        const prEl = document.getElementById('f-price');
        if (!prEl.value) prEl.value = sug;
      } else {
        rrEl.classList.remove('show');
        cbEl.classList.remove('show');
        document.getElementById('price-sug').style.display = 'none';
      }

      updatePreview();
    }

    function eta(km) {
      const h = km / 60;
      if (h < 1) return '~' + Math.round(h * 60) + 'm';
      const hh = Math.floor(h), mm = Math.round((h - hh) * 60);
      return mm > 0 ? '~' + hh + 'h ' + mm + 'm' : '~' + hh + 'h';
    }

    // ── AMENITY CHIPS ──
    function toggleChip(btn, key) {
      amenities[key] = !amenities[key];
      btn.classList.toggle('on', amenities[key]);
    }

    // ── LIVE PREVIEW ──
    function updatePreview() {
      const from = document.getElementById('f-from')?.value || '';
      const to = document.getElementById('f-to')?.value || '';
      const price = document.getElementById('f-price')?.value || '';
      const seats = document.getElementById('f-seats')?.value || '3';
      const date = document.getElementById('f-date')?.value || '';
      const time = document.getElementById('f-time')?.value || '';

      // Cities
      const pcFrom = document.getElementById('pc-from');
      const pcTo = document.getElementById('pc-to');
      pcFrom.textContent = from || 'From';
      pcFrom.className = 'pc-city' + (from ? '' : ' dim');
      pcTo.textContent = to || 'To';
      pcTo.className = 'pc-city' + (to ? '' : ' dim');

      // Duration chip
      document.getElementById('pc-dur').textContent =
        currentKm ? eta(currentKm) + ' · ' + currentKm + ' km' : '—';

      // Time & date meta
      document.getElementById('pc-time').textContent = '🕐 ' + (time || '—');
      if (date) {
        const d = new Date(date);
        document.getElementById('pc-date').textContent =
          '📅 ' + d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      } else {
        document.getElementById('pc-date').textContent = '📅 —';
      }

      // Distance & cashback in meta
      const kmEl = document.getElementById('pc-km');
      const cashEl = document.getElementById('pc-cash');
      if (currentKm) {
        const cb = (currentKm * 0.5).toFixed(0);
        kmEl.textContent = '📍 ' + currentKm + ' km';
        cashEl.textContent = '🎁 Passengers earn ₹' + cb + ' cashback';
        kmEl.style.display = 'flex';
        cashEl.style.display = 'flex';
      } else {
        kmEl.style.display = 'none';
        cashEl.style.display = 'none';
      }

      // Price & seats
      document.getElementById('pc-price').textContent = price ? '₹' + price : '₹—';
      document.getElementById('pc-seats').textContent = seats + ' seat' + (seats > 1 ? 's' : '');

      // Earnings breakdown
      if (price && currentKm) {
        const total = +price * +seats;
        const cb = (currentKm * 0.5).toFixed(0);
        document.getElementById('earn-fare').textContent = '₹' + price;
        document.getElementById('earn-seats').textContent = seats;
        document.getElementById('earn-total').textContent = '₹' + total;
        document.getElementById('earn-cb').textContent = '₹' + cb + ' / booking';
        document.getElementById('earn-card').style.display = 'block';
      } else {
        document.getElementById('earn-card').style.display = 'none';
      }
    }

    // ── PUBLISH RIDE ──
    async function publishRide() {

      let token = localStorage.getItem('flu_token');
      try {
        const fbUser = firebase.auth().currentUser;
        if (fbUser) {
          token = await fbUser.getIdToken(true); // force refresh
          localStorage.setItem('flu_token', token);
        }
      } catch (e) { }

      if (!token) { openAuth('login'); return; }

      const from = document.getElementById('f-from').value;
      const to = document.getElementById('f-to').value;
      const date = document.getElementById('f-date').value;
      const time = document.getElementById('f-time').value;
      const seats = document.getElementById('f-seats').value;
      const price = document.getElementById('f-price').value;
      const note = document.getElementById('f-note').value;

      const errEl = document.getElementById('form-err');
      errEl.style.display = 'none';

      // Validate
      if (!from || !to) { showErr('Please select From and To cities.'); return; }
      if (from === to) { showErr('From and To cities cannot be the same.'); return; }
      if (!date || !time) { showErr('Please select departure date and time.'); return; }
      if (!price || +price < 10) { showErr('Please enter a valid price (min ₹10).'); return; }

      const btn = document.getElementById('submit-btn');
      btn.textContent = 'Publishing…';
      btn.disabled = true;

      try {
        const res = await fetch('/api/rides/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({
            from, to, date, departureTime: time,
            availableSeats: +seats, pricePerSeat: +price,
            distanceKm: currentKm, duration: currentKm ? eta(currentKm) : null,
            amenities, note
          })
        });
        const data = await res.json();

        if (res.ok) {
          // Update local ride count
          driverStatus.ridesThisMonth = (driverStatus.ridesThisMonth || 0) + 1;
          updateStatusBar();

          // Hide all form sections, show success
          ['fsec-route', 'fsec-dt', 'fsec-sp', 'fsec-am'].forEach(id => {
            document.getElementById(id).style.display = 'none';
          });
          document.getElementById('success-scr').classList.add('show');

          // If this was their 3rd ride and no sub → show subscription popup
          if (!driverStatus.subscription && driverStatus.ridesThisMonth >= 3) {
            setTimeout(() => openSubPopup(), 1800);
          }

        } else if (res.status === 402) {
          // Payment required — subscription needed
          btn.textContent = 'Publish Ride →';
          btn.disabled = false;
          openSubPopup();
        } else {
          showErr(data.message || 'Publish failed. Please try again.');
          btn.textContent = 'Publish Ride →';
          btn.disabled = false;
        }
      } catch (e) {
        showErr('Something went wrong. Check your connection.');
        btn.textContent = 'Publish Ride →';
        btn.disabled = false;
      }
    }

    function showErr(msg) {
      const el = document.getElementById('form-err');
      el.textContent = msg; el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // ── SUBSCRIPTION POPUP ──
    function openSubPopup() {
      document.getElementById('sub-backdrop').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeSubPopup() {
      document.getElementById('sub-backdrop').classList.remove('open');
      document.body.style.overflow = '';
    }
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('sub-backdrop').addEventListener('click', e => {
        if (e.target.id === 'sub-backdrop') closeSubPopup();
      });
    });

    function choosePlan(plan, price) {
      // Highlight chosen plan
      document.querySelectorAll('.plan').forEach(p => p.classList.remove('highlight'));
      document.querySelector(`[onclick="choosePlan('${plan}',${price})"]`).classList.add('highlight');

      // TODO: Integrate Razorpay here
      // Example:
      // const options = {
      //   key: 'YOUR_RAZORPAY_KEY',
      //   amount: price * 100,
      //   currency: 'INR',
      //   name: 'FLU',
      //   description: plan + ' subscription',
      //   handler: function(response) { activatePlan(plan, response.razorpay_payment_id); }
      // };
      // new Razorpay(options).open();

      alert(`Razorpay payment for ₹${price}/month ${plan.charAt(0).toUpperCase() + plan.slice(1)} plan will open here.\n\n(Payment gateway integration pending)`);
    }

    // ── RESET FORM ──
    function resetForm() {
      ['fsec-route', 'fsec-dt', 'fsec-sp', 'fsec-am'].forEach(id => {
        document.getElementById(id).style.display = 'block';
      });
      document.getElementById('success-scr').classList.remove('show');
      document.getElementById('f-from').value = '';
      document.getElementById('f-to').value = '';
      document.getElementById('f-price').value = '';
      document.getElementById('f-note').value = '';
      document.getElementById('route-result').classList.remove('show');
      document.getElementById('cb-note').classList.remove('show');
      document.getElementById('price-sug').style.display = 'none';
      document.getElementById('submit-btn').textContent = 'Publish Ride →';
      document.getElementById('submit-btn').disabled = false;
      currentKm = null;
      amenities = { ac: false, music: false, luggage: false, ladies: false };
      document.querySelectorAll('.chip').forEach(c => c.classList.remove('on'));
      document.getElementById('form-err').style.display = 'none';
      updatePreview();

      // If still needs subscription → show wall again
      if (!driverStatus.subscription && driverStatus.ridesThisMonth >= 3) {
        openSubPopup();
      }
    }

    // ── AUTH ──
    function openAuth(t) {
      ['login-modal', 'signup-modal'].forEach(id => document.getElementById(id).classList.remove('open'));
      document.getElementById(t + '-modal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeAuth() {
      ['login-modal', 'signup-modal'].forEach(id => document.getElementById(id).classList.remove('open'));
      document.body.style.overflow = '';
    }
    ['login-modal', 'signup-modal'].forEach(id =>
      document.getElementById(id).addEventListener('click', e => { if (e.target.id === id) closeAuth(); })
    );
    document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeAuth(); closeSubPopup(); } });

    async function doLogin(e) {
      e.preventDefault();
      const err = document.getElementById('login-err');
      err.style.display = 'none';
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: document.getElementById('l-email').value, password: document.getElementById('l-pass').value })
        });
        const data = await res.json();
        if (res.ok) { saveUser(data.token, data.user); closeAuth(); showDashboard(data.user); }
        else { err.textContent = data.message; err.style.display = 'block'; }
      } catch { err.textContent = 'Something went wrong.'; err.style.display = 'block'; }
    }

    async function doSignup(e) {
      e.preventDefault();
      const err = document.getElementById('signup-err');
      err.style.display = 'none';
      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: document.getElementById('s-name').value,
            email: document.getElementById('s-email').value,
            password: document.getElementById('s-pass').value,
            phoneNumber: document.getElementById('s-phone').value
          })
        });
        const data = await res.json();
        if (res.ok) { saveUser(data.token, data.user); closeAuth(); showDashboard(data.user); }
        else { err.textContent = data.message; err.style.display = 'block'; }
      } catch { err.textContent = 'Something went wrong.'; err.style.display = 'block'; }
    }

    // ── SESSION ──
    function saveUser(token, user) {
      localStorage.setItem('flu_token', token);
      localStorage.setItem('flu_user', JSON.stringify(user));
    }
    function getUser() {
      const u = localStorage.getItem('flu_user');
      return u ? JSON.parse(u) : null;
    }
    function logout() {
      localStorage.removeItem('flu_token');
      localStorage.removeItem('flu_user');
      location.href = '/';
    }
    function renderNav(user) {
      if (!user) return;
      document.getElementById('nav-av').textContent = user.name.charAt(0).toUpperCase();
      document.getElementById('nav-uname').textContent = user.name.split(' ')[0];
    }
  </script>

