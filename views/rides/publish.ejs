<%- include('../partials/header') %>

  <style>
    @import url('https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@300,400,500,700&display=swap');

    :root {
      --lime: #C8F135;
      --mint: #95CFB0;
      --black: #080808;
      --white: #ffffff;
      --card: #101010;
      --border: #1e1e1e;
      --grey: #888;
      --dark: #1c1c1c;
      --red: #ff4040;
      --orange: #ff8c00;
    }

    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--black);
      color: var(--white);
      font-family: 'Satoshi', sans-serif;
      overflow-x: hidden;
      min-height: 100vh;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button {
      font-family: 'Satoshi', sans-serif;
      cursor: pointer;
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 9999;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
      opacity: 0.03;
    }

    /* ══ NAVBAR ══ */
    .nav {
      position: fixed;
      top: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
      width: calc(100% - 4rem);
      max-width: 1100px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(8, 8, 8, 0.8);
      backdrop-filter: blur(24px);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 0.65rem 0.65rem 0.65rem 1.8rem;
      transition: transform 0.4s;
    }

    .nav.hidden {
      transform: translateX(-50%) translateY(-140%);
    }

    .nav-logo {
      font-family: 'Clash Display', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 4px;
      color: var(--lime);
    }

    .nav-links {
      display: flex;
      gap: 0.2rem;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .nav-links a {
      font-size: 0.8rem;
      color: var(--grey);
      padding: 0.45rem 1rem;
      border-radius: 100px;
      transition: color .2s, background .2s;
    }

    .nav-links a:hover {
      color: var(--white);
      background: var(--dark);
    }

    .nav-links a.active {
      color: var(--black);
      background: var(--lime);
    }

    .nav-chip {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--dark);
      border-radius: 100px;
      padding: 0.3rem 0.9rem 0.3rem 0.4rem;
    }

    .nav-av {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--lime);
      color: var(--black);
      font-size: 0.68rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-uname {
      font-size: 0.78rem;
      color: var(--white);
      font-weight: 500;
    }

    .btn-ghost-nav {
      background: transparent;
      border: none;
      color: var(--grey);
      font-size: 0.8rem;
      padding: 0.45rem 0.9rem;
      border-radius: 100px;
      transition: color .2s;
    }

    .btn-ghost-nav:hover {
      color: var(--white);
    }

    /* ══ BACK PILL ══ */
    .back-pill-wrap {
      padding: 6.5rem 4rem 0;
    }

    .back-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      color: var(--grey);
      font-size: 0.78rem;
      padding: 0.4rem 1rem;
      border-radius: 100px;
      opacity: 0;
      transform: translateY(10px);
      animation: fadeUp 0.6s ease 0.2s forwards;
      transition: color .2s, border-color .2s;
    }

    .back-pill:hover {
      color: var(--white);
      border-color: #444;
    }

    /* ══ HERO ══ */
    .hero {
      min-height: 38vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 2rem 4rem 3rem;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid var(--border);
    }

    .hero-glow1 {
      position: absolute;
      top: -20%;
      right: -5%;
      width: 700px;
      height: 500px;
      background: radial-gradient(ellipse, rgba(200, 241, 53, .06) 0%, transparent 65%);
      pointer-events: none;
    }

    .hero-glow2 {
      position: absolute;
      bottom: -30%;
      left: 10%;
      width: 500px;
      height: 400px;
      background: radial-gradient(ellipse, rgba(149, 207, 176, .04) 0%, transparent 65%);
      pointer-events: none;
    }

    .hero-lines {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .hero-lines span {
      position: absolute;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(200, 241, 53, .08), transparent);
      animation: hline 4s linear infinite;
      opacity: 0;
    }

    .hero-lines span:nth-child(1) {
      top: 30%;
      width: 35%;
      animation-delay: 0s;
    }

    .hero-lines span:nth-child(2) {
      top: 55%;
      width: 55%;
      animation-delay: 1.2s;
    }

    .hero-lines span:nth-child(3) {
      top: 70%;
      width: 25%;
      animation-delay: 2.4s;
    }

    @keyframes hline {
      0% {
        left: -60%;
        opacity: 0
      }

      10% {
        opacity: 1
      }

      90% {
        opacity: .5
      }

      100% {
        left: 110%;
        opacity: 0
      }
    }

    .hero-h1 {
      font-family: 'Clash Display', sans-serif;
      font-size: clamp(3.5rem, 9vw, 8rem);
      font-weight: 700;
      line-height: .88;
      letter-spacing: -.5px;
    }

    .hero-h1 .word {
      display: inline-block;
      overflow: hidden;
      margin-right: .12em;
    }

    .hero-h1 .word span {
      display: inline-block;
      transform: translateY(110%);
      transition: transform .8s cubic-bezier(.16, 1, .3, 1);
    }

    .hero-h1 .lime {
      color: var(--lime);
    }

    .hero-h1 .mint {
      color: var(--mint);
    }

    .hero-sub {
      color: var(--grey);
      font-size: .95rem;
      line-height: 1.8;
      max-width: 520px;
      margin-top: 1.8rem;
      opacity: 0;
      animation: fadeUp .6s ease 1.1s forwards;
    }

    @keyframes fadeUp {
      to {
        opacity: 1;
        transform: translateY(0)
      }
    }

    /* ══ STATUS BAR ══ */
    .status-bar {
      max-width: 1100px;
      margin: 2.5rem auto 0;
      padding: 0 4rem;
      opacity: 0;
      animation: fadeUp .5s ease .3s forwards;
    }

    .sb-inner {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.1rem 1.6rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .sb-rides-num {
      font-family: 'Clash Display', sans-serif;
      font-size: 1.8rem;
      font-weight: 700;
      line-height: 1;
      transition: color .3s;
    }

    .sb-rides-lbl {
      font-size: .62rem;
      color: var(--grey);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-top: .1rem;
    }

    .sb-divider {
      width: 1px;
      height: 40px;
      background: var(--border);
      flex-shrink: 0;
    }

    .sb-track-wrap {
      flex: 1;
      min-width: 160px;
    }

    .sb-track-top {
      display: flex;
      justify-content: space-between;
      font-size: .65rem;
      color: var(--grey);
      margin-bottom: .45rem;
    }

    .sb-track {
      height: 5px;
      background: var(--border);
      border-radius: 5px;
      overflow: hidden;
    }

    .sb-fill {
      height: 100%;
      border-radius: 5px;
      transition: width .7s cubic-bezier(.16, 1, .3, 1), background .3s;
    }

    .sb-plan-wrap {
      display: flex;
      flex-direction: column;
      gap: .1rem;
    }

    .sb-plan-name {
      font-size: .85rem;
      font-weight: 600;
      color: var(--white);
    }

    .sb-plan-sub {
      font-size: .62rem;
      color: var(--grey);
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .sb-badge {
      font-size: .6rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: .2rem .65rem;
      border-radius: 100px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .badge-free {
      background: rgba(200, 241, 53, .1);
      color: var(--lime);
      border: 1px solid rgba(200, 241, 53, .25);
    }

    .badge-warn {
      background: rgba(255, 140, 0, .1);
      color: var(--orange);
      border: 1px solid rgba(255, 140, 0, .25);
    }

    .badge-locked {
      background: rgba(255, 64, 64, .1);
      color: var(--red);
      border: 1px solid rgba(255, 64, 64, .25);
    }

    .badge-sub {
      background: rgba(149, 207, 176, .1);
      color: var(--mint);
      border: 1px solid rgba(149, 207, 176, .25);
    }

    /* Fine warning strip */
    .fine-strip {
      max-width: 1100px;
      margin: .75rem auto 0;
      padding: 0 4rem;
      display: none;
    }

    .fine-strip.show {
      display: block;
    }

    .fine-inner {
      background: rgba(255, 64, 64, .06);
      border: 1px solid rgba(255, 64, 64, .2);
      border-radius: 12px;
      padding: .8rem 1.2rem;
      display: flex;
      align-items: center;
      gap: .8rem;
      font-size: .8rem;
      color: #ff7070;
    }

    .fine-inner b {
      color: var(--red);
    }

    /* ══ LAYOUT ══ */
    .pub-layout {
      display: grid;
      grid-template-columns: 1fr 370px;
      gap: 2rem;
      max-width: 1100px;
      margin: 2rem auto 0;
      padding: 0 4rem 5rem;
      align-items: start;
    }

    /* ══ AUTH GATE ══ */
    .auth-gate {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 4rem 2rem;
      grid-column: 1/-1;
    }

    .auth-gate.show {
      display: flex;
    }

    .ag-ico {
      font-size: 3rem;
      margin-bottom: 1.2rem;
      opacity: .4;
    }

    .ag-h {
      font-family: 'Clash Display', sans-serif;
      font-size: 1.6rem;
      font-weight: 700;
      margin-bottom: .75rem;
    }

    .ag-p {
      color: var(--grey);
      font-size: .88rem;
      margin-bottom: 2rem;
      line-height: 1.7;
    }

    .ag-btns {
      display: flex;
      gap: .75rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn-lime-pill {
      background: var(--lime);
      color: var(--black);
      border: none;
      padding: .75rem 1.8rem;
      border-radius: 100px;
      font-size: .84rem;
      font-weight: 700;
      font-family: 'Clash Display', sans-serif;
      -webkit-text-fill-color: var(--black);
      transition: opacity .2s;
    }

    .btn-lime-pill:hover {
      opacity: .88;
    }

    .btn-ghost-pill {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--white);
      padding: .75rem 1.8rem;
      border-radius: 100px;
      font-size: .84rem;
      transition: border-color .2s;
    }

    .btn-ghost-pill:hover {
      border-color: var(--grey);
    }

    /* ══ FORM SECTIONS ══ */
    .form-col {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .fsec {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 2rem;
      position: relative;
      overflow: hidden;
      opacity: 0;
      transform: translateY(18px);
      animation: fadeUp .5s ease forwards;
    }

    .fsec:nth-child(1) {
      animation-delay: .1s;
    }

    .fsec:nth-child(2) {
      animation-delay: .18s;
    }

    .fsec:nth-child(3) {
      animation-delay: .26s;
    }

    .fsec:nth-child(4) {
      animation-delay: .34s;
    }

    .fsec::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(200, 241, 53, .14), transparent);
    }

    .fsec-hd {
      font-family: 'Clash Display', sans-serif;
      font-size: 1rem;
      color: white;
      font-weight: 700;
      margin-bottom: 1.4rem;
      display: flex;
      align-items: center;
      gap: .65rem;
      letter-spacing: .3px;
    }

    .fsec-ico {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: white;
      border: 1px solid rgba(200, 241, 53, .12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .85rem;
      flex-shrink: 0;
    }

    .fgrid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .fg {
      display: flex;
      flex-direction: column;
      gap: .38rem;
    }

    .fg.full {
      grid-column: 1/-1;
    }

    .fl {
      font-size: .62rem;
      color: var(--grey);
      letter-spacing: 2.5px;
      text-transform: uppercase;
      font-weight: 500;
    }

    .fi,
    .fsel,
    .fta {
      background: #111;
      border: 1px solid var(--border);
      color: var(--white);
      padding: .85rem 1rem;
      border-radius: 12px;
      font-size: .87rem;
      font-family: 'Satoshi', sans-serif;
      outline: none;
      transition: border-color .25s, background .25s;
      width: 100%;
      color-scheme: dark;
    }

    .fi::placeholder {
      color: #333;
    }

    .fi:focus,
    .fsel:focus,
    .fta:focus {
      border-color: var(--lime);
      background: #141414;
    }

    .fsel {
      cursor: pointer;
    }

    .fsel option {
      background: #111;
    }

    .fta {
      resize: vertical;
      min-height: 80px;
      line-height: 1.6;
    }

    /* Route result banner */
    .route-result {
      display: none;
      margin-top: 1rem;
      background: rgba(200, 241, 53, .04);
      border: 1px solid rgba(200, 241, 53, .14);
      border-radius: 12px;
      padding: .9rem 1.2rem;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .route-result.show {
      display: flex;
    }

    .rr-route {
      font-family: 'Clash Display', sans-serif;
      font-size: 1rem;
      font-weight: 700;
    }

    .rr-arrow {
      color: var(--lime);
      margin: 0 .45rem;
    }

    .rr-pills {
      display: flex;
      gap: .8rem;
    }

    .rr-pill {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .08rem;
    }

    .rr-val {
      font-family: 'Clash Display', sans-serif;
      font-size: 1rem;
      font-weight: 700;
    }

    .rr-val.mint {
      color: var(--mint);
    }

    .rr-key {
      font-size: .6rem;
      color: var(--grey);
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    /* Cashback note (for passenger) */
    .cb-note {
      display: none;
      margin-top: .8rem;
      align-items: center;
      gap: .55rem;
      background: rgba(149, 207, 176, .05);
      border: 1px solid rgba(149, 207, 176, .15);
      border-radius: 10px;
      padding: .65rem 1rem;
      font-size: .78rem;
      color: var(--mint);
    }

    .cb-note.show {
      display: flex;
    }

    /* Price suggestion */
    .price-sug {
      font-size: .7rem;
      color: var(--grey);
      margin-top: .38rem;
      display: none;
    }

    .price-sug b {
      color: var(--mint);
    }

    /* Amenity chips */
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: .45rem;
    }

    .chip {
      display: flex;
      align-items: center;
      gap: .38rem;
      padding: .42rem .85rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      color: var(--grey);
      font-size: .77rem;
      background: transparent;
      transition: all .2s;
    }

    .chip:hover {
      border-color: #2a2a2a;
      color: var(--white);
    }

    .chip.on {
      border-color: var(--lime);
      color: var(--lime);
      background: rgba(200, 241, 53, .06);
    }

    .chip-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }

    /* Form error */
    .ferr {
      background: rgba(255, 60, 50, .07);
      border: 1px solid rgba(255, 60, 50, .2);
      color: #ff5555;
      font-size: .78rem;
      padding: .6rem .9rem;
      border-radius: 10px;
      margin-bottom: 1rem;
      display: none;
    }

    /* Submit */
    .fsub-btn {
      width: 100%;
      background: var(--lime);
      color: var(--black);
      border: none;
      padding: 1.05rem;
      border-radius: 12px;
      font-size: .92rem;
      font-weight: 700;
      font-family: 'Clash Display', sans-serif;
      letter-spacing: 1px;
      transition: opacity .2s, transform .2s;
      -webkit-text-fill-color: var(--black);
    }

    .fsub-btn:hover {
      opacity: .88;
      transform: translateY(-1px);
    }

    .fsub-btn:disabled {
      background: var(--dark);
      cursor: not-allowed;
      transform: none;
      opacity: 1;
      -webkit-text-fill-color: var(--grey);
    }

    .fsub-note {
      text-align: center;
      font-size: .68rem;
      color: #2a2a2a;
      margin-top: .55rem;
    }

    /* Success screen */
    .success-scr {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 3rem 1rem;
    }

    .success-scr.show {
      display: flex;
    }

    .suc-ico {
      font-size: 3.5rem;
      margin-bottom: 1.4rem;
    }

    .suc-h {
      font-family: 'Clash Display', sans-serif;
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--lime);
      margin-bottom: .7rem;
    }

    .suc-p {
      color: var(--grey);
      font-size: .87rem;
      line-height: 1.75;
      margin-bottom: 2rem;
    }

    .suc-btns {
      display: flex;
      gap: .75rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* ══ PREVIEW CARD (right col) ══ */
    .preview-col {
      position: sticky;
      top: 7rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      opacity: 0;
      animation: fadeUp .5s ease .4s forwards;
    }

    .prev-lbl {
      font-size: .62rem;
      color: var(--grey);
      letter-spacing: 3px;
      text-transform: uppercase;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: .5rem;
    }

    .prev-lbl::before {
      content: '';
      width: 12px;
      height: 1px;
      background: var(--mint);
    }

    .pcard {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 1.6rem;
      position: relative;
      overflow: hidden;
    }

    .pcard::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--lime), transparent);
    }

    .pc-route {
      display: flex;
      align-items: center;
      gap: .55rem;
      margin-bottom: 1.1rem;
    }

    .pc-city {
      font-family: 'Clash Display', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -.3px;
    }

    .pc-city.dim {
      color: #2a2a2a;
    }

    .pc-mid {
      flex: 1;
      display: flex;
      align-items: center;
      gap: .3rem;
    }

    .pc-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--border), rgba(200, 241, 53, .3), var(--border));
    }

    .pc-arrow {
      color: var(--lime);
      font-size: .82rem;
    }

    .pc-dur {
      font-size: .63rem;
      color: var(--grey);
      background: var(--dark);
      padding: .18rem .5rem;
      border-radius: 100px;
      letter-spacing: 1px;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .pc-meta {
      display: flex;
      flex-wrap: wrap;
      gap: .7rem;
      margin-bottom: 1.1rem;
    }

    .pc-mi {
      color: white;
      font-size: .74rem;
      display: flex;
      align-items: center;
      gap: .3rem;
    }

    .pc-mi.lime {
      color: var(--lime);
    }

    .pc-mi.mint {
